#!/usr/bin/env ruby
# frozen_string_literal: true

require 'digest'
require 'fileutils'
require 'json'
require 'optparse'
require 'pathname'
require 'yaml'
require_relative '../lib/kb_contract_files'

options = {}
OptionParser.new do |parser|
  parser.banner = 'Usage: kb-contract-manifest --source DIR --candidate DIR --language cs|en --summary TEXT --output FILE'
  parser.on('--source DIR') { |value| options[:source] = File.expand_path(value) }
  parser.on('--candidate DIR') { |value| options[:candidate] = File.expand_path(value) }
  parser.on('--language LANGUAGE') { |value| options[:language] = value }
  parser.on('--summary TEXT') { |value| options[:summary] = value }
  parser.on('--output FILE') { |value| options[:output] = File.expand_path(value) }
end.parse!
abort 'unexpected arguments' unless ARGV.empty?
%i[source candidate language summary output].each do |key|
  abort "--#{key} is required" unless options[key]
end
abort '--language must be cs or en' unless %w[cs en].include?(options[:language])
abort '--summary must be a non-empty single line' if options[:summary].strip.empty? || options[:summary].match?(/[\r\n]/)

source_index = JSON.parse(File.read(File.join(options.fetch(:source), 'index.json')))
candidate_index = JSON.parse(File.read(File.join(options.fetch(:candidate), 'index.json')))
abort 'source index languages must be cs and en' unless source_index.keys.sort == %w[cs en]
source_keys = []
source_files = []
source_by_key = source_index.flat_map do |language, pages|
  abort "#{language}: source pages must be a list" unless pages.is_a?(Array)
  pages.map do |page|
    page_id = KbContractFiles.validate_page_id!(page.fetch('id'))
    source_file = page.fetch('file')
    source_path = KbContractFiles.path_within(options.fetch(:source), source_file)
    source_keys << [language, page_id]
    source_files << source_path
    [[language, page_id], page]
  end
end.to_h
abort 'duplicate source page IDs' unless source_keys.uniq.length == source_keys.length
abort 'duplicate source page files' unless source_files.uniq.length == source_files.length

candidate_pages = candidate_index.fetch('pages')
abort 'candidate pages must be a list' unless candidate_pages.is_a?(Array)
candidate_files = []
candidate_keys = candidate_pages.map do |page|
  language = page.fetch('language')
  abort "unknown candidate language #{language.inspect}" unless %w[cs en].include?(language)
  page_id = KbContractFiles.validate_page_id!(page.fetch('id'))
  candidate_files << KbContractFiles.path_within(
    options.fetch(:candidate),
    page.fetch('file')
  )
  [language, page_id]
end
abort 'duplicate candidate page IDs' unless candidate_keys.uniq.length == candidate_keys.length
abort 'duplicate candidate page files' unless candidate_files.uniq.length == candidate_files.length

czech_counterpart_pairs = candidate_pages.filter_map do |page|
  next unless page.fetch('language') == 'cs'

  content = File.binread(KbContractFiles.path_within(options.fetch(:candidate), page.fetch('file')))
  english_id = content[/<page>\s*([^<]+?)\s*<\/page>/, 1]
  KbContractFiles.validate_page_id!(english_id) if english_id
  [english_id, page.fetch('id')] if english_id
end
counterpart_ids = czech_counterpart_pairs.map(&:first)
abort 'duplicate English language counterparts' unless counterpart_ids.uniq.length == counterpart_ids.length
czech_counterparts = czech_counterpart_pairs.to_h

manifest_root = File.dirname(options.fetch(:output))
candidate_root = Pathname.new(options.fetch(:candidate))
root = Pathname.new(manifest_root)
begin
  candidate_relative = candidate_root.relative_path_from(root).to_s
rescue ArgumentError
  abort 'candidate directory must be below the manifest directory'
end
abort 'candidate directory must be below the manifest directory' if candidate_relative == '..' || candidate_relative.start_with?('../')

language = options.fetch(:language)
pages = candidate_pages.select do |page|
  page.fetch('language') == language && page.fetch('changed')
end.map do |page|
  source = source_by_key.fetch([language, page.fetch('id')])
  unless page.fetch('source_sha256') == source.fetch('sha256')
    abort "candidate was built from a different source snapshot for #{page.fetch('id')}"
  end
  source_content = File.binread(KbContractFiles.path_within(options.fetch(:source), source.fetch('file')))
  candidate_content = File.binread(KbContractFiles.path_within(options.fetch(:candidate), page.fetch('file')))
  unless Digest::SHA256.hexdigest(source_content) == source.fetch('sha256')
    abort "source checksum drift for #{page.fetch('id')}"
  end
  unless Digest::SHA256.hexdigest(candidate_content) == page.fetch('candidate_sha256')
    abort "candidate checksum drift for #{page.fetch('id')}"
  end
  entry = {
    'id' => page.fetch('id'),
    'source_revision' => source.fetch('revision'),
    'source_sha256' => source.fetch('sha256'),
    'file' => File.join(candidate_relative, page.fetch('file')),
    'sha256' => page.fetch('candidate_sha256')
  }
  if language == 'en'
    counterpart = czech_counterparts[page.fetch('id')]
    abort "missing Czech counterpart for #{page.fetch('id')}" unless counterpart

    entry['language_counterpart'] = counterpart
  end
  entry
end

manifest = {
  'schema' => 2,
  'wiki' => language == 'cs' ? 'cz' : 'org',
  'production_summary' => options.fetch(:summary),
  'pages' => pages,
  'media' => []
}
FileUtils.mkdir_p(File.dirname(options.fetch(:output)))
File.write(options.fetch(:output), YAML.dump(manifest))
puts "Prepared #{options.fetch(:output)} with #{pages.length} pages"
