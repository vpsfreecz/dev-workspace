#!/usr/bin/env ruby
# frozen_string_literal: true

require 'digest'
require 'fileutils'
require 'json'
require 'optparse'
require 'pathname'
require 'yaml'
require_relative '../lib/kb_contract_files'

options = {}
OptionParser.new do |parser|
  parser.banner = <<~USAGE
    Usage:
      kb-contract-manifest --source DIR --candidate DIR --language cs|en \
        --changes FILE --output FILE
      kb-contract-manifest --source DIR --candidate DIR --language cs|en \
        --summary TEXT --output FILE
  USAGE
  parser.on('--source DIR') { |value| options[:source] = File.expand_path(value) }
  parser.on('--candidate DIR') { |value| options[:candidate] = File.expand_path(value) }
  parser.on('--language LANGUAGE') { |value| options[:language] = value }
  parser.on('--summary TEXT') { |value| options[:summary] = value }
  parser.on('--changes FILE') { |value| options[:changes] = File.expand_path(value) }
  parser.on('--output FILE') { |value| options[:output] = File.expand_path(value) }
end.parse!
abort 'unexpected arguments' unless ARGV.empty?
%i[source candidate language output].each do |key|
  abort "--#{key} is required" unless options[key]
end
abort '--language must be cs or en' unless %w[cs en].include?(options[:language])
if options[:summary] && options[:changes]
  abort '--summary and --changes are mutually exclusive'
elsif !options[:summary] && !options[:changes]
  abort '--changes is required for new releases; use --summary only for a legacy schema-3 manifest'
elsif options[:summary] && (options[:summary].strip.empty? || options[:summary].match?(/[\r\n]/))
  abort '--summary must be a non-empty single line'
end

changes = if options[:changes]
            data = YAML.safe_load_file(options.fetch(:changes))
            abort 'changes file schema must be 1' unless data.is_a?(Hash) && data['schema'] == 1
            entries = data.fetch('changes')
            abort 'changes must be a list' unless entries.is_a?(Array)
            entries.map do |entry|
              abort 'each change must be a mapping' unless entry.is_a?(Hash)
              language = entry.fetch('language')
              abort "unknown change language #{language.inspect}" unless %w[cs en].include?(language)
              page_id = KbContractFiles.validate_page_id!(entry.fetch('id'))
              action = entry.fetch('action')
              abort "invalid change action #{action.inspect}" unless %w[write delete].include?(action)
              summary = entry.fetch('summary')
              unless summary.is_a?(String) && !summary.strip.empty? && !summary.match?(/[\r\n]/)
                abort "#{language}:#{page_id}: summary must be a non-empty single line"
              end
              entry.merge('language' => language, 'id' => page_id)
            end
          else
            []
          end
change_keys = changes.map { |entry| [entry.fetch('language'), entry.fetch('id')] }
abort 'duplicate page IDs in changes file' unless change_keys.uniq.length == change_keys.length
changes_by_key = changes.to_h { |entry| [[entry.fetch('language'), entry.fetch('id')], entry] }

source_index = JSON.parse(File.read(File.join(options.fetch(:source), 'index.json')))
candidate_index = JSON.parse(File.read(File.join(options.fetch(:candidate), 'index.json')))
abort 'source index languages must be cs and en' unless source_index.keys.sort == %w[cs en]
source_keys = []
source_files = []
source_by_key = source_index.flat_map do |language, pages|
  abort "#{language}: source pages must be a list" unless pages.is_a?(Array)
  pages.map do |page|
    page_id = KbContractFiles.validate_page_id!(page.fetch('id'))
    source_file = page.fetch('file')
    source_path = KbContractFiles.path_within(options.fetch(:source), source_file)
    source_keys << [language, page_id]
    source_files << source_path
    [[language, page_id], page]
  end
end.to_h
abort 'duplicate source page IDs' unless source_keys.uniq.length == source_keys.length
abort 'duplicate source page files' unless source_files.uniq.length == source_files.length

candidate_pages = candidate_index.fetch('pages')
abort 'candidate pages must be a list' unless candidate_pages.is_a?(Array)
candidate_files = []
candidate_keys = candidate_pages.map do |page|
  language = page.fetch('language')
  abort "unknown candidate language #{language.inspect}" unless %w[cs en].include?(language)
  page_id = KbContractFiles.validate_page_id!(page.fetch('id'))
  candidate_files << KbContractFiles.path_within(
    options.fetch(:candidate),
    page.fetch('file')
  )
  [language, page_id]
end
abort 'duplicate candidate page IDs' unless candidate_keys.uniq.length == candidate_keys.length
abort 'duplicate candidate page files' unless candidate_files.uniq.length == candidate_files.length
candidate_pages_by_key = candidate_pages.to_h do |page|
  [[page.fetch('language'), page.fetch('id')], page]
end

if options[:changes]
  candidate_write_keys = candidate_pages.filter_map do |page|
    [page.fetch('language'), page.fetch('id')] if page.fetch('changed')
  end
  declared_write_keys = changes.filter_map do |entry|
    [entry.fetch('language'), entry.fetch('id')] if entry.fetch('action') == 'write'
  end
  missing = candidate_write_keys - declared_write_keys
  extra = declared_write_keys - candidate_write_keys
  abort "changes file is missing page writes: #{missing.map { |key| key.join(':') }.join(', ')}" unless missing.empty?
  abort "changes file has extra page writes: #{extra.map { |key| key.join(':') }.join(', ')}" unless extra.empty?

  changes.select { |entry| entry.fetch('action') == 'delete' }.each do |entry|
    key = [entry.fetch('language'), entry.fetch('id')]
    source = source_by_key.fetch(key) { abort "#{key.join(':')}: deletion source page is not inventoried" }
    abort "#{key.join(':')}: deletion source page does not exist" if source['missing'] == true
    candidate = candidate_pages_by_key.fetch(key) do
      abort "#{key.join(':')}: deletion page is absent from candidate inventory"
    end
    abort "#{key.join(':')}: page cannot be changed and deleted" if candidate.fetch('changed')
  end
end

managed_pages = candidate_index.fetch('managed_pages', [])
abort 'managed_pages must be a list' unless managed_pages.is_a?(Array)
managed_contract = candidate_index['managed_contract']
if !managed_pages.empty? && !managed_contract.is_a?(Hash)
  abort 'managed candidate pages require contract provenance'
end

managed_contract_pages = []
managed_contract_tests = []
managed_contract_has_tests = false
managed_pages_by_key = {}
if managed_contract
  %w[base_commit head_commit registry_sha256].each do |key|
    value = managed_contract.fetch(key)
    pattern = key.end_with?('_commit') ? /\A[0-9a-f]{40}\z/ : /\A[0-9a-f]{64}\z/
    abort "invalid managed contract #{key}" unless value.is_a?(String) && value.match?(pattern)
  end
  repository = managed_contract.fetch('repository')
  unless repository.is_a?(String) && repository.match?(%r{\A[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+\z})
    abort 'invalid managed contract repository'
  end

  managed_contract_pages = managed_contract.fetch('pages')
  abort 'managed contract pages must be a list' unless managed_contract_pages.is_a?(Array)
  contract_page_keys = managed_contract_pages.map do |page|
    language = page.fetch('language')
    abort "unknown managed contract language #{language.inspect}" unless %w[cs en].include?(language)
    page_id = KbContractFiles.validate_page_id!(page.fetch('page'))
    KbContractFiles.validate_semantic_id!(page.fetch('article'))
    KbContractFiles.path_within(options.fetch(:candidate), page.fetch('source'))
    sha256 = page.fetch('sha256')
    unless sha256.is_a?(String) && sha256.match?(/\A[0-9a-f]{64}\z/)
      abort "#{language}:#{page_id}: invalid canonical SHA-256"
    end
    [language, page_id]
  end
  unless contract_page_keys.uniq.length == contract_page_keys.length
    abort 'duplicate managed contract page IDs'
  end

  managed_contract_has_tests = managed_contract.key?('tests')
  managed_contract_tests = managed_contract.fetch('tests', [])
  abort 'managed contract tests must be a list' unless managed_contract_tests.is_a?(Array)
  test_articles = managed_contract_tests.map do |test|
    article = KbContractFiles.validate_semantic_id!(test.fetch('article'))
    pattern = test.fetch('pattern')
    suite = pattern.delete_suffix('#*') if pattern.is_a?(String) && pattern.end_with?('#*')
    unless suite&.split('/', -1)&.all? do |component|
             component.match?(/\A[a-z0-9][a-z0-9_.-]*\z/) && !%w[. ..].include?(component)
           end
      abort "#{article}: invalid managed test pattern #{pattern.inspect}"
    end
    source = test.fetch('source')
    KbContractFiles.path_within(options.fetch(:candidate), source)
    expected_source = "tests/suite/#{suite}.nix"
    unless source == expected_source
      abort "#{article}: managed test source must be #{expected_source}, got #{source.inspect}"
    end
    sha256 = test.fetch('sha256')
    unless sha256.is_a?(String) && sha256.match?(/\A[0-9a-f]{64}\z/)
      abort "#{article}: invalid managed test SHA-256"
    end
    article
  end
  abort 'duplicate managed contract test articles' unless test_articles.uniq.length == test_articles.length
  test_patterns = managed_contract_tests.map { |test| test.fetch('pattern') }
  abort 'duplicate managed contract test patterns' unless test_patterns.uniq.length == test_patterns.length
  test_sources = managed_contract_tests.map { |test| test.fetch('source') }
  abort 'duplicate managed contract test sources' unless test_sources.uniq.length == test_sources.length
  page_articles = managed_contract_pages.map { |page| page.fetch('article') }.uniq
  unless managed_contract_tests.empty? || page_articles.sort == test_articles.sort
    abort 'managed contract tests must cover every registered article exactly once'
  end
  contract_pages_by_key = managed_contract_pages.to_h do |page|
    [[page.fetch('language'), page.fetch('page')], page]
  end

  managed_page_keys = managed_pages.map do |page|
    key = [page.fetch('language'), page.fetch('page')]
    contract_page = contract_pages_by_key.fetch(key) do
      abort "#{key.join(':')}: managed page is absent from contract provenance"
    end
    unless page.fetch('article') == contract_page.fetch('article') &&
           page.fetch('source') == contract_page.fetch('source') &&
           page.fetch('canonical_sha256') == contract_page.fetch('sha256')
      abort "#{key.join(':')}: managed page provenance differs from its contract entry"
    end
    candidate_page = candidate_pages_by_key.fetch(key) do
      abort "#{key.join(':')}: managed page is absent from candidate pages"
    end
    content = File.binread(
      KbContractFiles.path_within(options.fetch(:candidate), candidate_page.fetch('file'))
    )
    unless Digest::SHA256.hexdigest(content) == contract_page.fetch('sha256') &&
           candidate_page.fetch('candidate_sha256') == contract_page.fetch('sha256')
      abort "#{key.join(':')}: managed candidate differs from its canonical source"
    end
    key
  end
  abort 'duplicate managed page IDs' unless managed_page_keys.uniq.length == managed_page_keys.length
  managed_pages_by_key = managed_pages.to_h do |page|
    [[page.fetch('language'), page.fetch('page')], page]
  end

  contract_pages_by_key.each do |key, contract_page|
    candidate_page = candidate_pages_by_key.fetch(key) do
      abort "#{key.join(':')}: registered page is absent from candidate pages"
    end
    next unless candidate_page.fetch('changed')
    next if managed_pages_by_key.key?(key)

    abort "#{key.join(':')}: changed registered page lacks managed reconciliation"
  end
end

czech_counterpart_pairs = candidate_pages.filter_map do |page|
  next unless page.fetch('language') == 'cs'

  content = File.binread(KbContractFiles.path_within(options.fetch(:candidate), page.fetch('file')))
  english_id = content[/<page>\s*([^<]+?)\s*<\/page>/, 1]
  KbContractFiles.validate_page_id!(english_id) if english_id
  [english_id, page.fetch('id')] if english_id
end
counterpart_ids = czech_counterpart_pairs.map(&:first)
abort 'duplicate English language counterparts' unless counterpart_ids.uniq.length == counterpart_ids.length
czech_counterparts = czech_counterpart_pairs.to_h

manifest_root = File.dirname(options.fetch(:output))
candidate_root = Pathname.new(options.fetch(:candidate))
root = Pathname.new(manifest_root)
begin
  candidate_relative = candidate_root.relative_path_from(root).to_s
rescue ArgumentError
  abort 'candidate directory must be below the manifest directory'
end
abort 'candidate directory must be below the manifest directory' if candidate_relative == '..' || candidate_relative.start_with?('../')

language = options.fetch(:language)
pages = candidate_pages.select do |page|
  page.fetch('language') == language && page.fetch('changed')
end.map do |page|
  source = source_by_key.fetch([language, page.fetch('id')])
  policy = page.fetch('policy', 'update')
  abort "invalid page policy #{policy.inspect}" unless %w[create update].include?(policy)
  if policy == 'create'
    abort "source inventory does not guard new page #{page.fetch('id')}" unless source['missing'] == true
  elsif source['missing'] == true
    abort "missing source page #{page.fetch('id')} must use create policy"
  end
  unless page.fetch('source_sha256') == source.fetch('sha256')
    abort "candidate was built from a different source snapshot for #{page.fetch('id')}"
  end
  source_content = File.binread(KbContractFiles.path_within(options.fetch(:source), source.fetch('file')))
  candidate_content = File.binread(KbContractFiles.path_within(options.fetch(:candidate), page.fetch('file')))
  unless Digest::SHA256.hexdigest(source_content) == source.fetch('sha256')
    abort "source checksum drift for #{page.fetch('id')}"
  end
  unless Digest::SHA256.hexdigest(candidate_content) == page.fetch('candidate_sha256')
    abort "candidate checksum drift for #{page.fetch('id')}"
  end
  entry = {
    'id' => page.fetch('id'),
    'policy' => policy,
    'source_sha256' => source.fetch('sha256'),
    'file' => File.join(candidate_relative, page.fetch('file')),
    'sha256' => page.fetch('candidate_sha256')
  }
  entry['source_revision'] = source.fetch('revision') if policy == 'update'
  if language == 'en'
    counterpart = czech_counterparts[page.fetch('id')]
    abort "missing Czech counterpart for #{page.fetch('id')}" unless counterpart

    entry['language_counterpart'] = counterpart
  end
  entry['summary'] = changes_by_key.fetch([language, page.fetch('id')]).fetch('summary') if options[:changes]
  entry
end

deletions = changes.filter_map do |change|
  next unless change.values_at('language', 'action') == [language, 'delete']

  source = source_by_key.fetch([language, change.fetch('id')])
  source_content = File.binread(KbContractFiles.path_within(options.fetch(:source), source.fetch('file')))
  unless Digest::SHA256.hexdigest(source_content) == source.fetch('sha256')
    abort "source checksum drift for deletion #{change.fetch('id')}"
  end
  {
    'id' => change.fetch('id'),
    'source_revision' => source.fetch('revision'),
    'source_sha256' => source.fetch('sha256'),
    'summary' => change.fetch('summary')
  }
end

candidate_media = candidate_index.fetch('media', [])
abort 'candidate media must be a list' unless candidate_media.is_a?(Array)
candidate_media.each do |entry|
  media_language = entry.fetch('language')
  abort "unknown candidate media language #{media_language.inspect}" unless %w[cs en].include?(media_language)
  media_id = KbContractFiles.validate_media_id!(entry.fetch('id'))
  unless media_id.start_with?("#{media_language}:")
    abort "candidate media ID is in another language namespace: #{media_id}"
  end
end
media = candidate_media.select { |entry| entry.fetch('language') == language }.map do |entry|
  media_id = KbContractFiles.validate_media_id!(entry.fetch('id'))
  file = KbContractFiles.path_within(options.fetch(:candidate), entry.fetch('file'))
  content = File.binread(file)
  sha256 = Digest::SHA256.hexdigest(content)
  abort "candidate media checksum drift for #{media_id}" unless sha256 == entry.fetch('sha256')
  policy = entry.fetch('policy', 'create')
  abort "invalid media policy #{policy.inspect}" unless %w[create update].include?(policy)

  manifest_entry = {
    'id' => media_id,
    'file' => File.join(candidate_relative, entry.fetch('file')),
    'sha256' => sha256,
    'policy' => policy
  }
  manifest_entry['source_sha256'] = entry.fetch('source_sha256') if policy == 'update'
  manifest_entry
end

contract_manifest = if managed_contract
                      selected_pages = managed_contract_pages.filter_map do |page|
                        key = [page.fetch('language'), page.fetch('page')]
                        candidate_page = candidate_pages_by_key.fetch(key)
                        next unless key.first == language && candidate_page.fetch('changed')

                        {
                          'id' => key.last,
                          'article' => page.fetch('article'),
                          'source' => page.fetch('source'),
                          'sha256' => page.fetch('sha256')
                        }
                      end
                      selected_articles = selected_pages.map { |page| page.fetch('article') }.uniq
                      if selected_pages.empty?
                        nil
                      else
                        result = {
                          'repository' => managed_contract.fetch('repository'),
                          'base_commit' => managed_contract.fetch('base_commit'),
                          'head_commit' => managed_contract.fetch('head_commit'),
                          'registry_sha256' => managed_contract.fetch('registry_sha256'),
                          'pages' => selected_pages
                        }
                        if managed_contract_has_tests
                          result['tests'] = managed_contract_tests.select do |test|
                            selected_articles.include?(test.fetch('article'))
                          end
                        end
                        result
                      end
                    end

manifest = {
  'schema' => options[:changes] ? 4 : 3,
  'wiki' => language == 'cs' ? 'cz' : 'org',
  'pages' => pages,
  'media' => media
}
if options[:changes]
  manifest['deletions'] = deletions
else
  manifest['production_summary'] = options.fetch(:summary)
end
manifest['contract'] = contract_manifest if contract_manifest
FileUtils.mkdir_p(File.dirname(options.fetch(:output)))
File.write(options.fetch(:output), YAML.dump(manifest))
puts(
  "Prepared #{options.fetch(:output)} with #{pages.length} pages, #{deletions.length} deletions " \
  "and #{media.length} media objects"
)
