#!/usr/bin/env ruby
# frozen_string_literal: true

require 'digest'
require 'fileutils'
require 'json'
require 'optparse'
require 'yaml'
require_relative '../lib/kb_contract_files'
require_relative '../lib/kb_managed_articles'

options = {}
OptionParser.new do |parser|
  parser.banner = 'Usage: kb-contract-build --source DIR --plan FILE --output DIR [--captures DIR] [--code-root DIR --code-base FULL-OID]'
  parser.on('--source DIR') { |value| options[:source] = File.expand_path(value) }
  parser.on('--plan FILE') { |value| options[:plan] = File.expand_path(value) }
  parser.on('--output DIR') { |value| options[:output] = File.expand_path(value) }
  parser.on('--captures DIR') { |value| options[:captures] = File.expand_path(value) }
  parser.on('--code-root DIR') { |value| options[:code_root] = File.expand_path(value) }
  parser.on('--code-base FULL-OID') { |value| options[:code_base] = value }
end.parse!
abort 'unexpected arguments' unless ARGV.empty?
%i[source plan output].each { |key| abort "--#{key} is required" unless options[key] }
abort 'source and output directories must differ' if options[:source] == options[:output]

plan_file = YAML.safe_load_file(options.fetch(:plan))
schema = plan_file.fetch('schema')
abort 'replacement plan schema must be 1, 2, 3, or 4' unless [1, 2, 3, 4].include?(schema)
replacements = plan_file.fetch('replacements')
content_replacements = plan_file.fetch('content_replacements', [])
exceptions = plan_file.fetch('exceptions', [])
new_pages = plan_file.fetch('new_pages', [])
media_plan = plan_file.fetch('media', [])
code_sample_plan = plan_file.fetch('code_samples', [])
managed_article_plan = plan_file.fetch('managed_articles', [])
abort 'replacements must be a list' unless replacements.is_a?(Array)
abort 'content_replacements must be a list' unless content_replacements.is_a?(Array)
abort 'exceptions must be a list' unless exceptions.is_a?(Array)
abort 'new_pages must be a list' unless new_pages.is_a?(Array)
abort 'media must be a list' unless media_plan.is_a?(Array)
abort 'code_samples must be a list' unless code_sample_plan.is_a?(Array)
abort 'managed_articles must be a list' unless managed_article_plan.is_a?(Array)
if schema == 1 && (!new_pages.empty? || !media_plan.empty?)
  abort 'new_pages and media require replacement plan schema 2'
end
abort 'code_samples require replacement plan schema 3' if schema < 3 && !code_sample_plan.empty?
if schema < 3 && !content_replacements.empty?
  abort 'content_replacements require replacement plan schema 3'
end
abort 'managed_articles require replacement plan schema 4' if schema < 4 && !managed_article_plan.empty?

if schema == 4
  abort '--code-root is required for replacement plan schema 4' unless options[:code_root]
  abort '--code-base is required for replacement plan schema 4' unless options[:code_base]
end

unless code_sample_plan.empty?
  abort '--code-root is required when the plan contains code_samples' unless options[:code_root]
end
code_samples = code_sample_plan.map do |entry|
  id = KbContractFiles.validate_semantic_id!(entry.fetch('id'))
  relative = entry.fetch('file')
  language = entry.fetch('language')
  unless language.is_a?(String) && language.match?(/\A[a-zA-Z0-9_+-]+\z/)
    abort "#{id}: invalid DokuWiki code language #{language.inspect}"
  end
  path = KbContractFiles.path_within(options.fetch(:code_root), relative)
  content = File.read(path, encoding: Encoding::UTF_8)
  abort "#{id}: code sample must not be blank" if content.strip.empty?
  abort "#{id}: code sample contains a closing code tag" if content.include?('</code>')

  {
    'id' => id,
    'file' => relative,
    'language' => language,
    'sha256' => Digest::SHA256.hexdigest(content),
    'content' => content
  }
end
code_samples_by_id = code_samples.to_h { |entry| [entry.fetch('id'), entry] }
abort 'duplicate code sample IDs' unless code_samples_by_id.length == code_samples.length

managed_contract = nil
registered_contract_pages = []
if schema == 4
  begin
    managed_contract = KbManagedArticles.contract_provenance(
      code_root: options.fetch(:code_root),
      base: options.fetch(:code_base)
    )
    registered_contract_pages = KbManagedArticles.registered_pages(
      code_root: options.fetch(:code_root),
      contract: managed_contract,
      require_committed: true
    )
  rescue KbManagedArticles::Error => e
    abort e.message
  end
end
registered_contract_pages_by_key = registered_contract_pages.to_h do |page|
  [page.values_at(:language, :page), page]
end

legacy_page_targets = {
  'new_pages' => new_pages,
  'content_replacements' => content_replacements,
  'replacements' => replacements
}.flat_map do |kind, entries|
  entries.map do |entry|
    language = entry.fetch('language')
    page = entry.fetch('page')
    [kind, language, page]
  end
end
legacy_page_targets.each do |kind, language, page|
  managed = registered_contract_pages_by_key[[language, page]]
  next unless managed

  abort "#{language}:#{page}: registered managed pages cannot be changed through #{kind}; " \
        "use managed_articles entry #{managed.fetch(:article).inspect}"
end

source_root = options.fetch(:source)
output_root = options.fetch(:output)
source_index = JSON.parse(File.read(File.join(source_root, 'index.json')))
abort 'source index languages must be cs and en' unless source_index.keys.sort == %w[cs en]
source_page_keys = []
source_files = []
source_entries = {}
pages = source_index.flat_map do |language, entries|
  abort "#{language}: source pages must be a list" unless entries.is_a?(Array)
  entries.map do |entry|
    page_id = KbContractFiles.validate_page_id!(entry.fetch('id'))
    source_file = entry.fetch('file')
    source_path = KbContractFiles.path_within(source_root, source_file)
    key = [language, page_id]
    source_page_keys << key
    source_files << source_path
    source_entries[key] = entry
    [key, File.read(source_path, encoding: Encoding::UTF_8)]
  end
end.to_h
abort 'duplicate source page IDs' unless source_page_keys.uniq.length == source_page_keys.length
abort 'duplicate source page files' unless source_files.uniq.length == source_files.length
wiki_pages = pages.dup

new_page_plan = new_pages.map do |entry|
  language = entry.fetch('language')
  abort "unknown new-page language #{language.inspect}" unless %w[cs en].include?(language)
  page_id = KbContractFiles.validate_page_id!(entry.fetch('page'))
  body = entry.fetch('body')
  abort "#{language}:#{page_id}: new page body must not be blank" unless body.is_a?(String) && !body.strip.empty?
  if schema >= 3
    body.lines.each_cons(2).with_index(1) do |(line, following), line_number|
      next unless line.match?(/^\s{2,}[*-]\s+\S/)
      next unless following.match?(/^\s{4,}\S/)
      next if following.match?(/^\s{2,}[*-]\s+\S/)

      abort "#{language}:#{page_id}: list item on line #{line_number} is physically wrapped"
    end
  end

  key = [language, page_id]
  source = source_entries.fetch(key) do
    abort "#{language}:#{page_id}: new page is missing from the guarded source inventory"
  end
  abort "#{language}:#{page_id}: source inventory does not mark the page missing" unless source['missing'] == true
  abort "#{language}:#{page_id}: guarded new-page source is not empty" unless pages.fetch(key).empty?

  pages[key] = body
  {
    'language' => language,
    'page' => page_id,
    'body' => body
  }
end
new_page_keys = new_page_plan.map { |entry| [entry.fetch('language'), entry.fetch('page')] }
abort 'duplicate new page IDs' unless new_page_keys.uniq.length == new_page_keys.length
missing_source_keys = source_entries.filter_map { |key, entry| key if entry['missing'] == true }
unless missing_source_keys.sort == new_page_keys.sort
  abort 'every guarded missing source page must have exactly one new_pages entry'
end

managed_pages = managed_article_plan.flat_map do |entry|
  abort 'managed article entry must be a mapping' unless entry.is_a?(Hash)
  article_id = KbContractFiles.validate_semantic_id!(entry.fetch('id'))
  bootstrap = entry.fetch('bootstrap', {})
  abort "#{article_id}: bootstrap must be a mapping" unless bootstrap.is_a?(Hash)
  unknown_languages = bootstrap.keys - %w[cs en]
  unless unknown_languages.empty?
    abort "#{article_id}: unknown bootstrap languages #{unknown_languages.join(', ')}"
  end

  begin
    results = KbManagedArticles.reconcile(
      code_root: options.fetch(:code_root),
      base: options.fetch(:code_base),
      article_id: article_id,
      wiki_pages: pages,
      bootstrap: bootstrap,
      contract: managed_contract,
      require_committed: true
    )
  rescue KbManagedArticles::Error => e
    abort e.message
  end

  blocked = results.select { |result| %i[wiki_only conflict].include?(result.fetch(:status)) }
  unless blocked.empty?
    states = blocked.map do |result|
      "#{result.fetch(:language)}:#{result.fetch(:page)}=#{result.fetch(:status).to_s.tr('_', '-')}"
    end
    abort "#{article_id}: managed article reconciliation failed (#{states.join(', ')}); " \
          'use kb-contract-reconcile before building'
  end

  results.map do |result|
    key = [result.fetch(:language), result.fetch(:page)]
    source = source_entries.fetch(key) do
      abort "#{article_id}: managed page #{key.join(':')} is missing from the guarded source inventory"
    end
    abort "#{article_id}: managed page #{key.join(':')} is marked missing" if source['missing'] == true

    pages[key] = result.fetch(:current)
    {
      'article' => article_id,
      'language' => result.fetch(:language),
      'page' => result.fetch(:page),
      'source' => result.fetch(:source),
      'status' => result.fetch(:status).to_s,
      'canonical_sha256' => result.fetch(:canonical_sha256)
    }
  end
end
managed_page_keys = managed_pages.map { |entry| [entry.fetch('language'), entry.fetch('page')] }
abort 'duplicate managed page IDs' unless managed_page_keys.uniq.length == managed_page_keys.length

unless code_samples.empty?
  registered_contract_pages.each do |registered|
    key = registered.values_at(:language, :page)
    next unless pages.fetch(key).include?('<kb-code-sample')

    abort "#{key.join(':')}: registered managed pages cannot use release-time code sample expansion"
  end
end

content_replacement_plan = content_replacements.map do |replacement|
  language = replacement.fetch('language')
  abort "unknown content-replacement language #{language.inspect}" unless %w[cs en].include?(language)
  page = replacement.fetch('page')
  KbContractFiles.validate_page_id!(page)
  before = replacement.fetch('before')
  abort "#{language}:#{page}: before must not be blank" unless before.is_a?(String) && !before.empty?
  replacement_text = replacement.fetch('replacement')
  unless replacement_text.is_a?(String)
    abort "#{language}:#{page}: replacement must be a string"
  end
  count = replacement.fetch('count', 1)
  unless count.is_a?(Integer) && count.positive?
    abort "#{language}:#{page}: replacement count must be positive"
  end

  key = [language, page]
  content = pages.fetch(key)
  actual_count = content.scan(before).length
  unless actual_count == count
    abort "#{language}:#{page}: content replacement expected #{count} matches, found #{actual_count}"
  end

  pages[key] = content.gsub(before) { replacement_text }
  {
    'language' => language,
    'page' => page,
    'count' => count,
    'before' => before,
    'replacement' => replacement_text
  }
end

annotation_plan = replacements.map do |replacement|
  language = replacement.fetch('language')
  abort "unknown replacement language #{language.inspect}" unless %w[cs en].include?(language)
  page = replacement.fetch('page')
  KbContractFiles.validate_page_id!(page)
  path = KbContractFiles.validate_semantic_id!(replacement.fetch('path'))
  before = replacement.fetch('before')
  abort "#{language}:#{page}: before must not be blank" unless before.is_a?(String) && !before.empty?
  count = replacement.fetch('count', 1)
  abort "#{language}:#{page}: replacement count must be positive" unless count.is_a?(Integer) && count.positive?

  key = [language, page]
  content = pages.fetch(key)
  actual_count = content.scan(before).length
  unless actual_count == count
    abort "#{language}:#{page}: #{path} expected #{count} matches, found #{actual_count}"
  end

  body = replacement.fetch('body', before)
  abort "#{language}:#{page}: body must be a string" unless body.is_a?(String)
  tagged = replacement.fetch(
    'replacement',
    %(<vpsadmin-nav id="#{path}">#{body}</vpsadmin-nav>)
  )
  tag_pattern = /<vpsadmin-nav\s+id="#{Regexp.escape(path)}">.*?<\/vpsadmin-nav>/m
  unless tagged.scan(tag_pattern).length == 1 &&
         tagged.scan('<vpsadmin-nav').length == 1 &&
         tagged.scan('</vpsadmin-nav>').length == 1
    abort "#{language}:#{page}: #{path} replacement must contain exactly one matching tag"
  end
  tag_body = tagged.match(tag_pattern)[0][/<vpsadmin-nav\s+id="[^"]+">(.*?)<\/vpsadmin-nav>/m, 1]
  unless tag_body == body
    abort "#{language}:#{page}: #{path} replacement tag body differs from body"
  end

  pages[key] = content.gsub(before) { tagged }
  {
    'language' => language,
    'page' => page,
    'path' => path,
    'count' => count,
    'before' => before,
    'body' => body,
    'replacement' => tagged
  }
end

exceptions.each do |entry|
  language = entry.fetch('language')
  abort "unknown exception language #{language.inspect}" unless %w[cs en].include?(language)
  KbContractFiles.validate_page_id!(entry.fetch('page'))
  KbContractFiles.validate_semantic_id!(entry.fetch('path'))
  reason = entry.fetch('reason')
  abort 'exception reason must not be blank' unless reason.is_a?(String) && !reason.strip.empty?
end

code_sample_uses = Hash.new(0)
placeholder_pattern = /<kb-code-sample\s+id="([^"]+)"\s*\/>/
pages.transform_values! do |content|
  content.gsub(placeholder_pattern) do
    id = Regexp.last_match(1)
    sample = code_samples_by_id.fetch(id) { abort "unknown code sample #{id.inspect}" }
    code_sample_uses[id] += 1
    sample_content = sample.fetch('content').sub(/\n*\z/, "\n")
    "<code #{sample.fetch('language')}>\n#{sample_content}</code>"
  end
end
unused_code_samples = code_samples_by_id.keys - code_sample_uses.keys
unless unused_code_samples.empty?
  abort "unused code samples: #{unused_code_samples.join(', ')}"
end
pages.each do |(language, page), content|
  next unless content.include?('<kb-code-sample')

  abort "#{language}:#{page}: unresolved code sample placeholder"
end

managed_pages.each do |managed|
  key = managed.values_at('language', 'page')
  canonical = registered_contract_pages_by_key.fetch(key).fetch(:current)
  next if pages.fetch(key) == canonical

  abort "#{key.join(':')}: managed candidate differs from its canonical contract source"
end
registered_contract_pages.each do |registered|
  key = registered.values_at(:language, :page)
  next if managed_page_keys.include?(key)
  next if pages.fetch(key) == wiki_pages.fetch(key)

  abort "#{key.join(':')}: registered managed page changed without a managed_articles entry"
end

managed_contract_index = if managed_contract
                           {
                             'repository' => managed_contract.fetch(:repository),
                             'base_commit' => managed_contract.fetch(:base_commit),
                             'head_commit' => managed_contract.fetch(:head_commit),
                             'registry_sha256' => managed_contract.fetch(:registry_sha256),
                             'pages' => registered_contract_pages.map do |page|
                               {
                                 'article' => page.fetch(:article),
                                 'language' => page.fetch(:language),
                                 'page' => page.fetch(:page),
                                 'source' => page.fetch(:source),
                                 'sha256' => page.fetch(:sha256)
                               }
                             end
                           }
                         end

candidate_index = {
  'pages' => [],
  'media' => [],
  'annotations' => annotation_plan,
  'content_replacements' => content_replacement_plan,
  'new_pages' => new_page_plan,
  'managed_pages' => managed_pages,
  'code_samples' => code_samples.map { |entry| entry.except('content') },
  'exceptions' => exceptions
}
candidate_index['managed_contract'] = managed_contract_index if managed_contract_index
pages.sort.each do |(language, page_id), content|
  relative = File.join(language, *page_id.split(':')) + '.txt'
  source = File.read(
    KbContractFiles.path_within(source_root, relative),
    encoding: Encoding::UTF_8
  )
  destination = KbContractFiles.path_within(output_root, relative)
  FileUtils.mkdir_p(File.dirname(destination))
  File.binwrite(destination, content)
  candidate_index.fetch('pages') << {
    'language' => language,
    'id' => page_id,
    'file' => relative,
    'policy' => source_entries.fetch([language, page_id])['missing'] == true ? 'create' : 'update',
    'changed' => content != source,
    'source_sha256' => Digest::SHA256.hexdigest(source),
    'candidate_sha256' => Digest::SHA256.hexdigest(content)
  }
end

unless media_plan.empty?
  abort '--captures is required when the plan contains media' unless options[:captures]
  capture_root = options.fetch(:captures)
  capture_index = JSON.parse(File.read(File.join(capture_root, 'captures.json')))
  assets = capture_index.fetch('assets')
  abort 'capture assets must be a list' unless assets.is_a?(Array)
  assets_by_id = assets.to_h do |asset|
    capture_id = KbContractFiles.validate_capture_id!(asset.fetch('id'))
    [capture_id, asset]
  end
  abort 'duplicate capture asset IDs' unless assets_by_id.length == assets.length

  media_plan.each do |entry|
    language = entry.fetch('language')
    abort "unknown media language #{language.inspect}" unless %w[cs en].include?(language)
    policy = entry.fetch('policy', 'create')
    abort "invalid media policy #{policy.inspect}" unless %w[create update].include?(policy)
    source_sha256 = entry['source_sha256']
    if policy == 'update'
      unless source_sha256.is_a?(String) && source_sha256.match?(/\A[0-9a-f]{64}\z/)
        abort "update media source_sha256 must be a SHA-256 digest"
      end
    elsif entry.key?('source_sha256')
      abort "create media must not declare source_sha256"
    end
    capture_id = KbContractFiles.validate_capture_id!(entry.fetch('capture'))
    asset = assets_by_id.fetch(capture_id) { abort "unknown capture asset #{capture_id.inspect}" }
    variant = asset.fetch('variants').fetch(language)
    media_id = KbContractFiles.validate_media_id!(variant.fetch('wiki').fetch('media_id'))
    unless media_id.start_with?("#{language}:")
      abort "#{capture_id}: #{language} media ID is in another language namespace: #{media_id}"
    end
    output = KbContractFiles.path_within(capture_root, variant.fetch('output'))
    content = File.binread(output)
    abort "#{capture_id}: #{language} capture is not a PNG" unless content.start_with?("\x89PNG\r\n\x1a\n".b)
    sha256 = Digest::SHA256.hexdigest(content)
    abort "#{capture_id}: #{language} capture checksum drift" unless sha256 == variant.fetch('sha256')

    relative = File.join('media', language, *media_id.split(':'))
    destination = KbContractFiles.path_within(output_root, relative)
    FileUtils.mkdir_p(File.dirname(destination))
    File.binwrite(destination, content)
    candidate_media = {
      'language' => language,
      'id' => media_id,
      'capture' => capture_id,
      'file' => relative,
      'policy' => policy,
      'sha256' => sha256
    }
    candidate_media['source_sha256'] = source_sha256 if policy == 'update'
    candidate_index.fetch('media') << candidate_media
  end
end
media_keys = candidate_index.fetch('media').map { |entry| [entry.fetch('language'), entry.fetch('id')] }
abort 'duplicate candidate media IDs' unless media_keys.uniq.length == media_keys.length

FileUtils.mkdir_p(output_root)
File.write(
  File.join(output_root, 'index.json'),
  "#{JSON.pretty_generate(candidate_index)}\n"
)

cell = lambda do |value|
  value.to_s.gsub('|', '\\|').gsub("\n", ' ↵ ')
end
review = [
  '# KB navigation annotation review',
  '',
  "Changed pages: #{candidate_index.fetch('pages').count { |page| page.fetch('changed') }}",
  "New pages: #{new_page_plan.length}",
  "Selected media: #{candidate_index.fetch('media').length}",
  "Annotation tags: #{annotation_plan.sum { |entry| entry.fetch('count') }}",
  "Content replacements: #{content_replacement_plan.sum { |entry| entry.fetch('count') }}",
  "Managed pages: #{managed_pages.length}",
  '',
  '| Language | Page | Semantic path | Count | Existing text | Candidate text |',
  '| --- | --- | --- | ---: | --- | --- |'
]
annotation_plan.each do |entry|
  review << "| #{cell.call(entry.fetch('language'))} | #{cell.call(entry.fetch('page'))} " \
            "| `#{cell.call(entry.fetch('path'))}` | #{entry.fetch('count')} " \
            "| #{cell.call(entry.fetch('before'))} | #{cell.call(entry.fetch('replacement'))} |"
end
review.concat([
  '',
  '## Guarded content replacements',
  '',
  '| Language | Page | Count | Existing text | Candidate text |',
  '| --- | --- | ---: | --- | --- |'
])
content_replacement_plan.each do |entry|
  review << "| #{cell.call(entry.fetch('language'))} | #{cell.call(entry.fetch('page'))} " \
            "| #{entry.fetch('count')} | #{cell.call(entry.fetch('before'))} " \
            "| #{cell.call(entry.fetch('replacement'))} |"
end
review.concat([
  '',
  '## Managed articles',
  '',
  '| Article | Language | Page | Reconciliation | Canonical source |',
  '| --- | --- | --- | --- | --- |'
])
managed_pages.each do |entry|
  review << "| `#{entry.fetch('article')}` | #{entry.fetch('language')} | " \
            "#{entry.fetch('page')} | #{entry.fetch('status').tr('_', '-')} | " \
            "`#{entry.fetch('source')}` |"
end
review.concat([
  '',
  '## Explicit exceptions',
  '',
  '| Language | Page | Semantic path | Reason |',
  '| --- | --- | --- | --- |'
])
exceptions.each do |entry|
  review << "| #{cell.call(entry.fetch('language'))} | #{cell.call(entry.fetch('page'))} " \
            "| `#{cell.call(entry.fetch('path'))}` | #{cell.call(entry.fetch('reason'))} |"
end
review.concat([
  '',
  '## New pages',
  '',
  '| Language | Page | SHA-256 |',
  '| --- | --- | --- |'
])
new_page_plan.each do |entry|
  page = candidate_index.fetch('pages').find do |candidate|
    candidate.fetch('language') == entry.fetch('language') && candidate.fetch('id') == entry.fetch('page')
  end
  review << "| #{entry.fetch('language')} | #{entry.fetch('page')} | `#{page.fetch('candidate_sha256')}` |"
end
review.concat([
  '',
  '## Canonical code samples',
  '',
  '| ID | File | Language | Uses | SHA-256 |',
  '| --- | --- | --- | ---: | --- |'
])
code_samples.each do |entry|
  review << "| `#{entry.fetch('id')}` | #{cell.call(entry.fetch('file'))} | " \
            "#{cell.call(entry.fetch('language'))} | #{code_sample_uses.fetch(entry.fetch('id'))} | " \
            "`#{entry.fetch('sha256')}` |"
end
review.concat([
  '',
  '## Selected capture media',
  '',
  '| Language | Capture | Media ID | SHA-256 |',
  '| --- | --- | --- | --- |'
])
candidate_index.fetch('media').each do |entry|
  review << "| #{entry.fetch('language')} | `#{entry.fetch('capture')}` | " \
            "#{entry.fetch('id')} | `#{entry.fetch('sha256')}` |"
end
File.write(File.join(output_root, 'review.md'), "#{review.join("\n")}\n")

puts "Prepared #{candidate_index.fetch('pages').count { |page| page.fetch('changed') }} changed pages " \
     "with #{annotation_plan.sum { |entry| entry.fetch('count') }} annotations and " \
     "#{candidate_index.fetch('media').length} media objects and " \
     "#{content_replacement_plan.sum { |entry| entry.fetch('count') }} content replacements"
