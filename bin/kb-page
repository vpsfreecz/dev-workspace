#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'
require 'net/http'
require 'optparse'
require 'uri'
require 'base64'

module KbPage
  WIKIS = {
    'cz' => {
      url: 'https://kb.vpsfree.cz',
      token_path: '/home/aither/.codex/codex-kb-vpsfree-cz-aither-key',
      environment: :production
    },
    'org' => {
      url: 'https://kb.vpsfree.org',
      token_path: '/home/aither/.codex/codex-kb-vpsfree-org-aither-key',
      environment: :production
    },
    'cz-staging' => {
      url: 'http://kb-cs.aitherdev.int.vpsfree.cz',
      username: 'aither',
      password_path: '/home/aither/.codex/codex-kb-staging-cz-aither-password',
      environment: :staging
    },
    'org-staging' => {
      url: 'http://kb-en.aitherdev.int.vpsfree.cz',
      username: 'aither',
      password_path: '/home/aither/.codex/codex-kb-staging-org-aither-password',
      environment: :staging
    }
  }.freeze

  ACL_EDIT = 2
  ACL_CREATE = 4
  ACL_UPLOAD = 8
  ACL_DELETE = 16

  USAGE = <<~USAGE
    Usage:
      kb-page whoami --wiki WIKI
      kb-page acl --wiki WIKI PAGE
      kb-page get --wiki WIKI PAGE
      kb-page save --wiki WIKI PAGE FILE --summary TEXT (--create|--update)
        [--minor] [--approved-production]
      kb-page delete --wiki WIKI PAGE --summary TEXT --yes
        [--approved-production]
      kb-page rename --wiki WIKI OLD_PAGE NEW_PAGE --summary TEXT
        [--overwrite] [--approved-production]
      kb-page media-info --wiki WIKI MEDIA
      kb-page media-get --wiki WIKI MEDIA FILE [--overwrite]
      kb-page media-save --wiki WIKI MEDIA FILE (--create|--update)
        [--approved-production]
      kb-page media-delete --wiki WIKI MEDIA --yes
        [--approved-production]

    WIKI is one of: cz, org, cz-staging, org-staging.
  USAGE

  class Error < StandardError; end

  class RpcError < Error
    attr_reader :code, :rpc_message

    def initialize(code, rpc_message)
      @code = code
      @rpc_message = rpc_message
      super("RPC failed: #{code} #{rpc_message}")
    end
  end

  def self.wiki_config(name)
    WIKIS.fetch(name) do
      raise Error, "unknown wiki '#{name}', expected one of: #{WIKIS.keys.join(', ')}"
    end
  end

  class JsonRpcClient
    def initialize(base_url:, token_path: nil, username: nil, password_path: nil, transport: nil)
      @base_url = base_url
      @token_path = token_path
      @username = username
      @password_path = password_path
      @transport = transport || method(:perform_request)

      if @token_path.nil? == @password_path.nil?
        raise Error, 'configure exactly one of token_path or password_path'
      end
      raise Error, 'username is required with password_path' if @password_path && @username.to_s.empty?
    end

    def call(method, params = nil)
      status, body = @transport.call(
        endpoint_uri,
        request_headers,
        JSON.generate(
          jsonrpc: '2.0',
          method:,
          params:,
          id: method
        )
      )

      response = JSON.parse(body)

      if response['error']
        error = response.fetch('error')
        raise RpcError.new(error['code'], error['message'])
      end

      unless status.between?(200, 299)
        raise Error, "HTTP #{status} from DokuWiki JSON-RPC endpoint"
      end

      response['result']
    rescue JSON::ParserError => e
      raise Error, "invalid JSON-RPC response: #{e.message}"
    end

    private

    def endpoint_uri
      URI.join("#{@base_url}/", 'lib/exe/jsonrpc.php')
    end

    def request_headers
      authorization = if @token_path
                        "Bearer #{secret(@token_path, 'token')}"
                      else
                        credentials = "#{@username}:#{secret(@password_path, 'password')}"
                        "Basic #{Base64.strict_encode64(credentials)}"
                      end

      { 'Content-Type' => 'application/json', 'Authorization' => authorization }
    end

    def secret(path, kind)
      File.read(path).strip
    rescue Errno::ENOENT
      raise Error, "#{kind} file not found: #{path}"
    end

    def perform_request(uri, headers, body)
      request = Net::HTTP::Post.new(uri)
      headers.each { |key, value| request[key] = value }
      request.body = body

      response = Net::HTTP.start(
        uri.hostname,
        uri.port,
        use_ssl: uri.scheme == 'https'
      ) do |http|
        http.request(request)
      end

      [response.code.to_i, response.body]
    end
  end

  class Runner
    def initialize(out: $stdout, err: $stderr, client_factory: nil, staging_owner_verifier: nil)
      @out = out
      @err = err
      @client_factory = client_factory || method(:build_client)
      @staging_owner_verifier = staging_owner_verifier || method(:verify_staging_owner!)
    end

    def run(argv)
      command = argv.shift
      raise Error, USAGE unless command

      case command
      when 'whoami'
        opts = parse_common(argv)
        no_more_args!(argv)
        whoami(opts)
      when 'acl'
        opts = parse_common(argv)
        page = require_arg!(argv, 'PAGE')
        no_more_args!(argv)
        acl(opts, page)
      when 'get'
        opts = parse_common(argv)
        page = require_arg!(argv, 'PAGE')
        no_more_args!(argv)
        get(opts, page)
      when 'save'
        save(argv)
      when 'delete'
        delete(argv)
      when 'rename'
        rename(argv)
      when 'media-info'
        opts = parse_common(argv)
        media = require_arg!(argv, 'MEDIA')
        no_more_args!(argv)
        media_info(opts, media)
      when 'media-get'
        media_get(argv)
      when 'media-save'
        media_save(argv)
      when 'media-delete'
        media_delete(argv)
      when '-h', '--help', 'help'
        @out.write(USAGE)
      else
        raise Error, "unknown command '#{command}'\n#{USAGE}"
      end
    end

    def whoami(opts)
      @out.puts(JSON.pretty_generate(client_for(opts).call('core.whoAmI')))
    end

    def acl(opts, page)
      @out.puts(client_for(opts).call('core.aclCheck', page:).to_i)
    end

    def get(opts, page)
      client = client_for(opts)
      raise Error, "page does not exist: #{page}" unless page_exists?(client, page)

      @out.write(client.call('core.getPage', page:))
    end

    def save(argv)
      opts = parse_write_options(argv, create_update: true)
      page = require_arg!(argv, 'PAGE')
      file = require_arg!(argv, 'FILE')
      no_more_args!(argv)
      require_summary!(opts)

      text = File.read(file)
      client = client_for(opts)
      exists = page_exists?(client, page)

      if opts[:create] && exists
        raise Error, "page already exists, refusing --create: #{page}"
      elsif opts[:update] && !exists
        raise Error, "page does not exist, refusing --update: #{page}"
      end

      require_write_authorization!(opts)
      verify_identity!(client)
      verify_permission!(
        client,
        page,
        exists ? ACL_EDIT : ACL_CREATE,
        exists ? 'update' : 'create'
      )

      save_page!(
        client,
        'core.savePage',
        page:,
        text:,
        summary: opts[:summary],
        isminor: opts[:minor]
      )

      @out.puts("saved #{page} on #{opts[:wiki]}")
    end

    def delete(argv)
      opts = parse_write_options(argv, require_yes: true)
      page = require_arg!(argv, 'PAGE')
      no_more_args!(argv)
      require_summary!(opts)
      raise Error, 'delete requires --yes' unless opts[:yes]

      client = client_for(opts)
      raise Error, "page does not exist: #{page}" unless page_exists?(client, page)

      require_write_authorization!(opts)
      verify_identity!(client)
      verify_permission!(client, page, ACL_DELETE, 'delete')

      save_page!(
        client,
        'core.savePage',
        page:,
        text: '',
        summary: opts[:summary],
        isminor: false
      )

      @out.puts("deleted #{page} on #{opts[:wiki]}")
    end

    def rename(argv)
      opts = parse_write_options(argv, allow_overwrite: true)
      old_page = require_arg!(argv, 'OLD_PAGE')
      new_page = require_arg!(argv, 'NEW_PAGE')
      no_more_args!(argv)
      require_summary!(opts)

      client = client_for(opts)
      raise Error, "source page does not exist: #{old_page}" unless page_exists?(client, old_page)

      dest_exists = page_exists?(client, new_page)
      if dest_exists && !opts[:overwrite]
        raise Error, "destination page already exists, use --overwrite: #{new_page}"
      end

      require_write_authorization!(opts)
      verify_identity!(client)
      verify_permission!(client, old_page, ACL_DELETE, 'delete source page')
      verify_permission!(
        client,
        new_page,
        dest_exists ? ACL_EDIT : ACL_CREATE,
        dest_exists ? 'overwrite destination page' : 'create destination page'
      )

      text = client.call('core.getPage', page: old_page)
      save_page!(
        client,
        'core.savePage',
        page: new_page,
        text:,
        summary: opts[:summary],
        isminor: false
      )
      save_page!(
        client,
        'core.savePage',
        page: old_page,
        text: '',
        summary: opts[:summary],
        isminor: false
      )

      @out.puts("renamed #{old_page} to #{new_page} on #{opts[:wiki]}")
    end

    def media_info(opts, media)
      info = client_for(opts).call('core.getMediaInfo', media:, hash: true)
      @out.puts(JSON.pretty_generate(info))
    end

    def media_get(argv)
      opts = parse_media_get_options(argv)
      media = require_arg!(argv, 'MEDIA')
      file = require_arg!(argv, 'FILE')
      no_more_args!(argv)

      if File.exist?(file) && !opts[:overwrite]
        raise Error, "local file already exists, use --overwrite: #{file}"
      end

      encoded = client_for(opts).call('core.getMedia', media:)
      data = Base64.strict_decode64(encoded)
      File.binwrite(file, data)
      @out.puts("saved #{media} from #{opts[:wiki]} to #{file}")
    rescue ArgumentError => e
      raise Error, "invalid base64 media response: #{e.message}"
    end

    def media_save(argv)
      opts = parse_media_write_options(argv, create_update: true)
      media = require_arg!(argv, 'MEDIA')
      file = require_arg!(argv, 'FILE')
      no_more_args!(argv)
      data = File.binread(file)
      validate_media_file!(media, data)

      client = client_for(opts)
      exists = media_exists?(client, media)
      if opts[:create] && exists
        raise Error, "media already exists, refusing --create: #{media}"
      elsif opts[:update] && !exists
        raise Error, "media does not exist, refusing --update: #{media}"
      end

      require_write_authorization!(opts)
      verify_identity!(client)
      verify_permission!(
        client,
        media,
        exists ? ACL_DELETE : ACL_UPLOAD,
        exists ? 'update media' : 'create media'
      )
      save_page!(
        client,
        'core.saveMedia',
        media:,
        base64: Base64.strict_encode64(data),
        overwrite: exists
      )

      @out.puts("saved media #{media} on #{opts[:wiki]}")
    end

    def media_delete(argv)
      opts = parse_media_write_options(argv, require_yes: true)
      media = require_arg!(argv, 'MEDIA')
      no_more_args!(argv)
      raise Error, 'media-delete requires --yes' unless opts[:yes]

      client = client_for(opts)
      raise Error, "media does not exist: #{media}" unless media_exists?(client, media)

      require_write_authorization!(opts)
      verify_identity!(client)
      verify_permission!(client, media, ACL_DELETE, 'delete media')
      save_page!(client, 'core.deleteMedia', media:)

      @out.puts("deleted media #{media} on #{opts[:wiki]}")
    end

    private

    def parse_common(argv)
      opts = {}
      parser = OptionParser.new do |parser_opts|
        parser_opts.on('--wiki WIKI', 'Configured wiki name') { |v| opts[:wiki] = v }
      end
      parser.permute!(argv)
      require_wiki!(opts)
      opts
    end

    def parse_write_options(
      argv,
      create_update: false,
      require_yes: false,
      allow_overwrite: false
    )
      opts = { minor: false }
      parser = OptionParser.new do |parser_opts|
        parser_opts.on('--wiki WIKI', 'Configured wiki name') { |v| opts[:wiki] = v }
        parser_opts.on('--summary TEXT', 'Edit summary') { |v| opts[:summary] = v }
        parser_opts.on('--approved-production', 'Allow production writes') do
          opts[:approved_production] = true
        end
        parser_opts.on('--approved-non-draft') do
          raise Error, '--approved-non-draft was replaced by --approved-production'
        end
        parser_opts.on('--minor', 'Mark save as minor') { opts[:minor] = true }

        if create_update
          parser_opts.on('--create', 'Require that the page does not exist') do
            opts[:create] = true
          end
          parser_opts.on('--update', 'Require that the page already exists') do
            opts[:update] = true
          end
        end

        parser_opts.on('--yes', 'Confirm deletion') { opts[:yes] = true } if require_yes
        if allow_overwrite
          parser_opts.on('--overwrite', 'Allow overwriting destination') do
            opts[:overwrite] = true
          end
        end
      end

      parser.permute!(argv)
      require_wiki!(opts)

      if create_update
        unless opts[:create] ^ opts[:update]
          raise Error, 'save requires exactly one of --create or --update'
        end
      end

      opts
    end

    def parse_media_get_options(argv)
      opts = {}
      parser = OptionParser.new do |parser_opts|
        parser_opts.on('--wiki WIKI', 'Configured wiki name') { |v| opts[:wiki] = v }
        parser_opts.on('--overwrite', 'Overwrite an existing local file') do
          opts[:overwrite] = true
        end
      end
      parser.permute!(argv)
      require_wiki!(opts)
      opts
    end

    def parse_media_write_options(argv, create_update: false, require_yes: false)
      opts = {}
      parser = OptionParser.new do |parser_opts|
        parser_opts.on('--wiki WIKI', 'Configured wiki name') { |v| opts[:wiki] = v }
        if create_update
          parser_opts.on('--create', 'Require that the media ID does not exist') do
            opts[:create] = true
          end
          parser_opts.on('--update', 'Require that the media ID already exists') do
            opts[:update] = true
          end
        end
        parser_opts.on('--yes', 'Confirm deletion') { opts[:yes] = true } if require_yes
        parser_opts.on('--approved-production', 'Allow production writes') do
          opts[:approved_production] = true
        end
        parser_opts.on('--approved-non-draft') do
          raise Error, '--approved-non-draft was replaced by --approved-production'
        end
      end
      parser.permute!(argv)
      require_wiki!(opts)
      if create_update && !(opts[:create] ^ opts[:update])
        raise Error, 'media-save requires exactly one of --create or --update'
      end
      opts
    end

    def require_wiki!(opts)
      raise Error, '--wiki is required' unless opts[:wiki]

      KbPage.wiki_config(opts[:wiki])
    end

    def require_summary!(opts)
      return if opts[:summary] && !opts[:summary].strip.empty?

      raise Error, '--summary is required for writes'
    end

    def require_arg!(argv, name)
      argv.shift || raise(Error, "missing #{name}")
    end

    def no_more_args!(argv)
      raise Error, "unexpected arguments: #{argv.join(' ')}" unless argv.empty?
    end

    def client_for(opts)
      @client_factory.call(KbPage.wiki_config(opts[:wiki]))
    end

    def build_client(wiki)
      JsonRpcClient.new(
        base_url: wiki.fetch(:url),
        token_path: wiki[:token_path],
        username: wiki[:username],
        password_path: wiki[:password_path]
      )
    end

    def page_exists?(client, page)
      client.call('core.getPageInfo', page:)
      true
    rescue RpcError => e
      raise unless e.rpc_message =~ /(does not exist|not exist|not found|doesn't exist)/i

      false
    end

    def media_exists?(client, media)
      client.call('core.getMediaInfo', media:)
      true
    rescue RpcError => e
      raise unless e.rpc_message =~ /(does not exist|not exist|not found|doesn't exist)/i

      false
    end

    def validate_media_file!(media, data)
      raise Error, 'media file is empty' if data.empty?

      extension = File.extname(media).downcase
      signatures = {
        '.png' => data.start_with?("\x89PNG\r\n\x1A\n".b),
        '.jpg' => data.start_with?("\xFF\xD8\xFF".b),
        '.jpeg' => data.start_with?("\xFF\xD8\xFF".b),
        '.gif' => data.start_with?('GIF87a'.b, 'GIF89a'.b),
        '.webp' => data.start_with?('RIFF'.b) && data.byteslice(8, 4) == 'WEBP'.b
      }

      valid = signatures.fetch(extension) do
        raise Error, "unsupported media extension: #{extension.empty? ? '(none)' : extension}"
      end
      raise Error, "file content does not match media extension #{extension}" unless valid
    end

    def require_write_authorization!(opts)
      wiki = KbPage.wiki_config(opts.fetch(:wiki))
      if wiki.fetch(:environment) == :production
        return if opts[:approved_production]

        raise Error, 'production writes require --approved-production'
      end

      @staging_owner_verifier.call
    end

    def verify_staging_owner!
      require_relative '../lib/kb_stage'

      KbStage.verify_current_owner!
    end

    def verify_identity!(client)
      identity = client.call('core.whoAmI')
      login = identity.is_a?(Hash) ? identity['login'] : nil
      raise Error, 'DokuWiki API identity is anonymous' if login.nil? || login.empty?
    end

    def verify_permission!(client, page, required, action)
      acl = client.call('core.aclCheck', page:).to_i
      return if acl >= required

      raise Error, "insufficient ACL for #{action} on #{page}: #{acl} < #{required}"
    end

    def save_page!(client, method, params)
      result = client.call(method, params)
      return if result == true

      raise Error, "#{method} did not report success"
    end
  end
end

if $PROGRAM_NAME == __FILE__
  begin
    KbPage::Runner.new.run(ARGV)
  rescue KbPage::Error, OptionParser::ParseError => e
    warn e.message
    exit(1)
  end
end
