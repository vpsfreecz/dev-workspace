#!/usr/bin/env ruby
# frozen_string_literal: true

require 'digest'
require 'fileutils'
require 'json'
require 'optparse'
require_relative '../lib/kb_contract_files'

options = { expect_new: [] }
OptionParser.new do |parser|
  parser.banner = 'Usage: kb-contract-fetch --output DIR [--expect-new LANGUAGE:PAGE]'
  parser.on('--output DIR') { |value| options[:output] = File.expand_path(value) }
  parser.on('--expect-new LANGUAGE:PAGE') { |value| options[:expect_new] << value }
end.parse!
abort 'unexpected arguments' unless ARGV.empty?
abort '--output is required' unless options[:output]

workspace = File.expand_path('..', __dir__)
load File.join(workspace, 'bin/kb-page')

output_root = options.fetch(:output)
wikis = { 'cs' => 'cz', 'en' => 'org' }.freeze
index = {}
expected_new = options.fetch(:expect_new).map do |value|
  language, page_id = value.split(':', 2)
  abort "invalid --expect-new value #{value.inspect}" unless wikis.key?(language) && page_id

  [language, KbContractFiles.validate_page_id!(page_id)]
end
abort 'duplicate --expect-new page IDs' unless expected_new.uniq.length == expected_new.length

wikis.each do |language, wiki|
  config = KbPage.wiki_config(wiki)
  client = KbPage::JsonRpcClient.new(
    base_url: config.fetch(:url),
    token_path: config.fetch(:token_path)
  )
  page_ids = client.call('core.listPages', namespace: '', depth: 20).filter_map do |page|
    page['id'] || page['page']
  end.uniq.sort
  abort "#{wiki}: core.listPages returned no pages" if page_ids.empty?
  expected_new.select { |entry| entry.first == language }.each do |_, page_id|
    abort "#{wiki}: expected new page already exists: #{page_id}" if page_ids.include?(page_id)
  end

  index[language] = page_ids.map do |page_id|
    KbContractFiles.validate_page_id!(page_id)
    info = client.call('core.getPageInfo', page: page_id)
    content = client.call('core.getPage', page: page_id)
    revision = info['revision'] || info['rev'] || info['lastModified']
    abort "#{wiki}:#{page_id}: source revision is missing" unless revision

    relative = File.join(language, *page_id.split(':')) + '.txt'
    destination = KbContractFiles.path_within(output_root, relative)
    FileUtils.mkdir_p(File.dirname(destination))
    File.binwrite(destination, content)
    {
      'id' => page_id,
      'file' => relative,
      'revision' => revision,
      'sha256' => Digest::SHA256.hexdigest(content)
    }
  end

  expected_new.select { |entry| entry.first == language }.each do |_, page_id|
    relative = File.join(language, *page_id.split(':')) + '.txt'
    destination = KbContractFiles.path_within(output_root, relative)
    FileUtils.mkdir_p(File.dirname(destination))
    File.binwrite(destination, '')
    index.fetch(language) << {
      'id' => page_id,
      'file' => relative,
      'missing' => true,
      'sha256' => Digest::SHA256.hexdigest('')
    }
  end
  index.fetch(language).sort_by! { |entry| entry.fetch('id') }
end

FileUtils.mkdir_p(output_root)
File.write(File.join(output_root, 'index.json'), "#{JSON.pretty_generate(index)}\n")
puts "Fetched #{index.fetch('cs').length} Czech and #{index.fetch('en').length} English pages"
