#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: workspace-portal-password-hash PASSWORD_FILE" >&2
  exit 2
fi

password_file=$1
if [[ ! -f "$password_file" || -L "$password_file" ]]; then
  echo "workspace portal password must be a regular, non-symlink file" >&2
  exit 1
fi
if [[ "$(stat -c '%u:%a' -- "$password_file")" != "$(id -u):600" ]]; then
  echo "workspace portal password must be owned by the current user with mode 0600" >&2
  exit 1
fi
if [[ "$(wc -c < "$password_file")" -ne 65 ]] ||
  [[ "$(wc -l < "$password_file")" -ne 1 ]] ||
  ! grep -Eq '^[0-9a-f]{64}$' "$password_file"; then
  echo "workspace portal password must contain one 64-character lowercase hex value" >&2
  exit 1
fi

hash=$(htpasswd -niBC 12 aither < "$password_file")
if [[ "$hash" == *$'\n'* ]] ||
  ! grep -Eq '^aither:\$2[aby]\$12\$[./A-Za-z0-9]{53}$' <<< "$hash"; then
  echo "htpasswd returned an invalid bcrypt record" >&2
  exit 1
fi
printf '%s\n' "$hash"
