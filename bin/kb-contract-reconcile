#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'
require 'open3'
require 'optparse'
require 'tempfile'
require_relative '../lib/kb_contract_files'
require_relative '../lib/kb_managed_pages'

options = { adopt: false, yes: false }
OptionParser.new do |parser|
  parser.banner = 'Usage: kb-contract-reconcile --source DIR --code-root DIR --page-key KEY --base FULL-OID [--adopt --yes]'
  parser.on('--source DIR') { |value| options[:source] = File.expand_path(value) }
  parser.on('--code-root DIR') { |value| options[:code_root] = File.expand_path(value) }
  parser.on('--page-key KEY') { |value| options[:page_key] = value }
  parser.on('--base FULL-OID') { |value| options[:base] = value }
  parser.on('--adopt') { options[:adopt] = true }
  parser.on('--yes') { options[:yes] = true }
end.parse!
abort 'unexpected arguments' unless ARGV.empty?
%i[source code_root page_key base].each do |key|
  abort "--#{key.to_s.tr('_', '-')} is required" unless options[key]
end
abort '--adopt requires --yes' if options[:adopt] && !options[:yes]
abort '--yes is only valid with --adopt' if options[:yes] && !options[:adopt]

source_index = JSON.parse(File.read(File.join(options.fetch(:source), 'index.json')))
abort 'source index languages must be cs and en' unless source_index.keys.sort == %w[cs en]
wiki_page_entries = source_index.flat_map do |language, pages|
  abort "#{language}: source pages must be a list" unless pages.is_a?(Array)

  pages.map do |page|
    id = KbContractFiles.validate_page_id!(page.fetch('id'))
    path = KbContractFiles.path_within(options.fetch(:source), page.fetch('file'))
    [[language, id], File.read(path, encoding: Encoding::UTF_8)]
  end
end
keys = wiki_page_entries.map(&:first)
abort 'duplicate source page IDs' unless keys.uniq.length == keys.length
wiki_pages = wiki_page_entries.to_h

begin
  results = KbManagedPages.reconcile(
    code_root: options.fetch(:code_root),
    base: options.fetch(:base),
    page_key: options.fetch(:page_key),
    wiki_pages: wiki_pages
  )
rescue KbManagedPages::Error => e
  abort e.message
end

results.each do |result|
  puts "#{result.fetch(:language)}:#{result.fetch(:id)} #{result.fetch(:status).to_s.tr('_', '-')}"
end

conflicts = results.select { |result| result.fetch(:status) == :conflict }
unless conflicts.empty?
  conflicts.each do |result|
    files = %i[current base wiki].to_h do |kind|
      file = Tempfile.new([kind.to_s, '.txt'])
      file.write(result.fetch(kind))
      file.close
      [kind, file]
    end
    output, _error, _status = Open3.capture3(
      'git', 'merge-file', '-p',
      files.fetch(:current).path,
      files.fetch(:base).path,
      files.fetch(:wiki).path
    )
    warn "Three-way conflict for #{result.fetch(:language)}:#{result.fetch(:id)}:"
    warn output
  ensure
    files&.each_value(&:unlink)
  end
  abort 'managed page has concurrent Git and wiki edits; merge them manually'
end

wiki_only = results.select { |result| result.fetch(:status) == :wiki_only }
unless options[:adopt]
  unless wiki_only.empty?
    abort 'managed page has wiki-only edits; rerun with --adopt --yes to import them'
  end
  exit
end

if wiki_only.empty?
  puts 'No wiki-only edits to adopt'
  exit
end

wiki_only.each do |result|
  File.write(result.fetch(:path), result.fetch(:wiki))
  puts "Adopted #{result.fetch(:language)}:#{result.fetch(:id)} into #{result.fetch(:source)}"
end
