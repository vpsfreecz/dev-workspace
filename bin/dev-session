#!/usr/bin/env ruby
# frozen_string_literal: true

require 'date'
require 'fileutils'
require 'open3'
require 'optparse'
require 'shellwords'

module VpsfreeDevSession
  SAFE_PART = /\A[A-Za-z0-9][A-Za-z0-9_-]*\z/

  SESSION_MARK = '@vpsfree_dev_session'
  SESSION_SLUG = '@vpsfree_dev_session_slug'
  WINDOW_KIND = '@vpsfree_dev_session_window'
  WINDOW_WORKTREE = '@vpsfree_dev_session_worktree'

  ENV_SLUG = 'VPSFREE_DEV_SESSION_SLUG'
  ENV_WORKSPACE = 'VPSFREE_DEV_SESSION_WORKSPACE'
  ENV_WORK_DIR = 'VPSFREE_DEV_SESSION_WORK_DIR'
  ENV_WORKTREES_DIR = 'VPSFREE_DEV_SESSION_WORKTREES_DIR'

  USAGE = <<~USAGE
    Usage:
      dev-session [--workspace DIR] [--tmux-socket NAME] start <name-or-slug>
        [--as-is] [--new] [--attach] [--no-attach] [--no-codex]
      dev-session [--workspace DIR] [--tmux-socket NAME] attach <name-or-slug> [--as-is]
      dev-session [--workspace DIR] [--tmux-socket NAME] sync <name-or-slug> [--as-is]
      dev-session [--workspace DIR] [--tmux-socket NAME] stop <name-or-slug> [--as-is]
      dev-session [--workspace DIR] [--tmux-socket NAME] remove <name-or-slug>
        [--as-is] [--force]
      dev-session [--workspace DIR] [--tmux-socket NAME] finalize <name-or-slug>
        [--as-is]
      dev-session [--workspace DIR] [--tmux-socket NAME] list [<name-or-slug>] [--as-is]
      dev-session [--workspace DIR] [--tmux-socket NAME] current

      dev-session [--workspace DIR] [--tmux-socket NAME] worktree add
        <name-or-slug> <project> [--as-is] [--name NAME] [--branch BRANCH]
        [--base REF] [--no-fetch]
      dev-session [--workspace DIR] [--tmux-socket NAME] worktree remove
        <name-or-slug> <name> [--as-is] [--force]
  USAGE

  class Error < StandardError; end

  class CommandError < Error
    attr_reader :argv, :status, :stdout, :stderr

    def initialize(argv, status, stdout, stderr)
      @argv = argv
      @status = status
      @stdout = stdout
      @stderr = stderr
      super(message)
    end

    def message
      parts = [
        "command failed with exit #{status.exitstatus}: #{argv.map(&:shellescape).join(' ')}"
      ]
      parts << stdout.strip unless stdout.empty?
      parts << stderr.strip unless stderr.empty?
      parts.join("\n")
    end
  end

  class CommandRunner
    def initialize(out:, err:)
      @out = out
      @err = err
    end

    def capture(argv, allow_failure: false)
      stdout, stderr, status = Open3.capture3(*argv.map(&:to_s))

      unless allow_failure || status.success?
        raise CommandError.new(argv, status, stdout, stderr)
      end

      [stdout, stderr, status]
    end

    def run(argv)
      stdout, stderr, status = capture(argv, allow_failure: true)

      @out.write(stdout)
      @err.write(stderr)

      raise CommandError.new(argv, status, stdout, stderr) unless status.success?

      status
    end
  end

  class Tmux
    Window = Struct.new(:id, :name, :kind, :worktree, keyword_init: true)
    Session = Struct.new(:id, :name, :mark, :slug, :workspace, keyword_init: true) do
      def managed?
        mark == '1' && slug == name
      end
    end

    SESSION_FORMAT = [
      "\#{session_id}",
      "\#{session_name}",
      "\#{#{SESSION_MARK}}",
      "\#{#{SESSION_SLUG}}",
      "\#{E:#{ENV_WORKSPACE}}"
    ].join("\t")

    def self.session_target(session)
      session.start_with?('$') ? "#{session}:" : "=#{session}:"
    end

    def self.window_target(session, window)
      "#{session_target(session)}=#{window}"
    end

    def initialize(runner:, socket: nil)
      @runner = runner
      @socket = socket
    end

    def argv(*args)
      base = ['tmux']
      base += ['-L', @socket] if @socket
      base + args
    end

    def capture(*args, allow_failure: false)
      @runner.capture(argv(*args), allow_failure:)
    end

    def run(*args)
      @runner.run(argv(*args))
    end

    def success?(*args)
      _stdout, _stderr, status = capture(*args, allow_failure: true)
      status.success?
    end

    def session(slug)
      session_for_target(Tmux.session_target(slug), expected_name: slug)
    end

    def session_by_id(id)
      session_for_target(Tmux.session_target(id))
    end

    def managed_session_identities
      stdout, _stderr, status = capture(
        'list-sessions',
        '-F',
        SESSION_FORMAT,
        allow_failure: true
      )
      return [] unless status.success?

      stdout.lines.filter_map do |line|
        identity = parse_session(line)
        identity if identity.managed?
      end
    end

    def current_session_identity(pane)
      stdout, _stderr, status = capture(
        'display-message',
        '-p',
        '-t',
        pane,
        SESSION_FORMAT,
        allow_failure: true
      )
      return nil unless status.success?

      identity = parse_session(stdout)
      identity if identity.managed?
    end

    def windows(session)
      format = [
        "\#{window_id}",
        "\#{window_name}",
        "\#{@vpsfree_dev_session_window}",
        "\#{@vpsfree_dev_session_worktree}"
      ].join("\t")
      stdout, _stderr, status = capture(
        'list-windows',
        '-t',
        Tmux.session_target(session),
        '-F',
        format,
        allow_failure: true
      )
      return [] unless status.success?

      stdout.lines.map do |line|
        id, name, kind, worktree = line.chomp.split("\t", -1)
        Window.new(id:, name:, kind:, worktree:)
      end
    end

    private

    def session_for_target(target, expected_name: nil)
      stdout, _stderr, status = capture(
        'display-message',
        '-p',
        '-t',
        target,
        SESSION_FORMAT,
        allow_failure: true
      )
      return nil unless status.success?

      identity = parse_session(stdout)
      return nil if expected_name && identity.name != expected_name

      identity
    end

    def parse_session(line)
      id, name, mark, slug, workspace = line.chomp.split("\t", -1)
      Session.new(id:, name:, mark:, slug:, workspace:)
    end
  end

  class Runner
    attr_reader :workspace, :today

    def initialize(
      workspace:,
      tmux_socket: nil,
      codex_command: nil,
      out: $stdout,
      err: $stderr,
      today: Date.today,
      command_runner: nil,
      tmux: nil,
      env: ENV,
      cwd: Dir.pwd
    )
      expanded_workspace = File.expand_path(workspace)
      unless File.directory?(expanded_workspace)
        raise Error, "workspace directory not found: #{expanded_workspace}"
      end
      @workspace = File.realpath(expanded_workspace)
      @out = out
      @err = err
      @today = today
      @command_runner = command_runner || CommandRunner.new(out:, err:)
      @tmux = tmux || Tmux.new(runner: @command_runner, socket: tmux_socket)
      @env = env
      @cwd = cwd
      @codex_command = codex_command || ENV.fetch('VPSFREE_DEV_SESSION_CODEX', 'codex')
    end

    def start(input, as_is:, new:, attach:, run_codex:)
      slug = resolve_start_slug(input, as_is:, new:)

      session = with_slug_lock(slug) do
        ensure_tracking_files(slug)

        selected_session = @tmux.session(slug)
        selected_session = if selected_session
                             ensure_managed_session!(slug, session: selected_session)
                           else
                             create_tmux_session(slug, run_codex:)
                           end

        sync_slug(slug, require_session: true, session: selected_session)
      end

      if attach.nil?
        attach = $stdout.tty?
      end

      if attach
        attach_to_session(session)
      else
        @out.puts "session: #{slug}"
        @out.puts "attach: #{attach_command(session.id).map(&:shellescape).join(' ')}"
      end
    end

    def attach(input, as_is:)
      slug = lookup_slug(input, as_is:)
      session = ensure_managed_session!(slug)
      attach_to_session(session)
    end

    def sync(input, as_is:)
      slug = lookup_slug(input, as_is:)
      with_slug_lock(slug) { sync_slug(slug, require_session: true) }
    end

    def stop(input, as_is:)
      slug = lookup_slug(input, as_is:)
      with_slug_lock(slug) do
        session = ensure_managed_session!(slug)
        revalidate_session!(session)
        @tmux.run('kill-session', '-t', Tmux.session_target(session.id))
      end
    end

    def remove(input, as_is:, force:)
      slug = lookup_slug(input, as_is:)
      with_slug_lock(slug) do
        session = @tmux.session(slug)

        known_state = session ||
                      File.directory?(work_dir(slug)) ||
                      File.directory?(worktrees_dir(slug))

        unless known_state
          raise Error, "no dev session state found for #{slug}"
        end

        session = ensure_managed_session!(slug, session:) if session

        entries = worktree_entries(slug)
        dirty_entries = entries.select { |entry| worktree_dirty?(entry.fetch(:path)) }

        if !force && !dirty_entries.empty?
          paths = dirty_entries.map { |entry| entry.fetch(:path) }.join(', ')
          raise Error, "worktree has uncommitted changes: #{paths}"
        end

        entries.each do |entry|
          remove_worktree_path(entry.fetch(:path), force:)
        end

        remove_empty_dir(worktrees_dir(slug))
        if session
          revalidate_session!(session)
          @tmux.run('kill-session', '-t', Tmux.session_target(session.id))
        end
      end
    end

    def finalize(input, as_is:)
      slug = lookup_slug(input, as_is:)
      with_slug_lock(slug) do
        source = work_dir(slug)
        destination = archive_dir(slug)

        raise Error, "work directory not found: #{source}" unless File.directory?(source)
        raise Error, "archive already exists: #{destination}" if File.exist?(destination)

        validate_tracking_files!(slug)
        validate_terminal_lifecycle!(slug)
        validate_tracking_committed!(slug)

        session = @tmux.session(slug)
        session = ensure_managed_session!(slug, session:) if session

        entries = worktree_entries(slug)
        unexpected = unexpected_worktree_entries(slug, entries)
        unless unexpected.empty?
          raise Error, "worktree group contains unmanaged entries: #{unexpected.join(', ')}"
        end

        dirty_entries = entries.select { |entry| worktree_dirty?(entry.fetch(:path)) }
        unless dirty_entries.empty?
          paths = dirty_entries.map { |entry| entry.fetch(:path) }.join(', ')
          raise Error, "worktree has uncommitted changes: #{paths}"
        end

        entries.each do |entry|
          remove_worktree_path(entry.fetch(:path), force: false)
        end

        remove_empty_dir(worktrees_dir(slug))
        FileUtils.mkdir_p(File.dirname(destination))
        FileUtils.mv(source, destination)
        if session
          revalidate_session!(session)
          @tmux.run('kill-session', '-t', Tmux.session_target(session.id))
        end

        @out.puts "archived: #{destination}"
        @out.puts "review and commit: work/#{slug} -> archive/#{slug}"
      end
    end

    def list(input = nil, as_is: false)
      slugs = if input
                [lookup_slug(input, as_is:)]
              else
                known_slugs
              end

      rows = slugs.sort.map do |slug|
        identity = @tmux.session(slug)
        session = if identity.nil?
                    'none'
                  elsif managed_by_workspace?(identity)
                    'managed'
                  elsif identity.managed?
                    'foreign'
                  else
                    'unmanaged'
                  end

        work = File.directory?(work_dir(slug)) ? 'yes' : 'no'
        {
          slug:,
          work:,
          worktrees: worktree_entries(slug).length.to_s,
          tmux: session
        }
      end

      print_rows(rows)
    end

    def current
      slug = current_slug
      @out.puts slug
      slug
    end

    def worktree_add(input, project, as_is:, name:, branch:, base:, fetch:)
      slug = build_slug(input, as_is:)
      validate_part!(project, 'project')
      validate_part!(name, 'worktree name') if name

      with_slug_lock(slug) do
        branch ||= slug
        validate_git_branch!(branch)

        ensure_tracking_files(slug)

        repo = repo_dir(project)
        raise Error, "repository not found: #{repo}" unless File.directory?(repo)

        @command_runner.run(['git', "--git-dir=#{repo}", 'fetch', 'origin']) if fetch

        base ||= origin_head(repo)
        name ||= project
        path = File.join(worktrees_dir(slug), name)

        raise Error, "worktree path already exists: #{path}" if File.exist?(path)

        FileUtils.mkdir_p(File.dirname(path))

        if branch_exists?(repo, branch)
          @command_runner.run(['git', "--git-dir=#{repo}", 'worktree', 'add', path, branch])
        else
          @command_runner.run([
            'git',
            "--git-dir=#{repo}",
            'worktree',
            'add',
            '-b',
            branch,
            path,
            base
          ])
        end

        sync_slug(slug, require_session: false)
        @out.puts path
      end
    end

    def worktree_remove(input, name, as_is:, force:)
      slug = lookup_slug(input, as_is:)
      validate_part!(name, 'worktree name')

      with_slug_lock(slug) do
        path = File.join(worktrees_dir(slug), name)
        raise Error, "worktree not found: #{path}" unless File.directory?(path)

        unless force || !worktree_dirty?(path)
          raise Error, "worktree has uncommitted changes: #{path}"
        end

        remove_worktree_path(path, force:)
        sync_slug(slug, require_session: false)
      end
    end

    def remove_worktree_path(path, force:)
      common_dir = git_capture(['git', '-C', path, 'rev-parse', '--git-common-dir']).strip
      common_dir = File.expand_path(common_dir, path)

      argv = ['git', "--git-dir=#{common_dir}", 'worktree', 'remove']
      argv << '--force' if force
      argv << path
      @command_runner.run(argv)
    end

    def build_slug(input, as_is:)
      validate_part!(input, as_is ? 'slug' : 'name')
      as_is ? input : "#{today.strftime('%F')}-#{input}"
    end

    def resolve_start_slug(input, as_is:, new:)
      raise Error, '--as-is and --new cannot be used together' if as_is && new

      if new
        if dated_slug?(input)
          raise Error, '--new requires a short name, not a dated slug'
        end

        return build_slug(input, as_is: false)
      end

      return build_slug(input, as_is: true) if as_is

      lookup_slug(input, as_is: false)
    rescue Error => e
      raise unless e.message.start_with?('no slug found for ')

      build_slug(input, as_is: false)
    end

    def lookup_slug(input, as_is:)
      validate_part!(input, as_is ? 'slug' : 'name')
      return input if as_is

      slugs = known_slugs
      return input if slugs.include?(input)

      matches = slugs.select { |slug| slug.end_with?("-#{input}") }

      case matches.length
      when 0
        raise Error, "no slug found for #{input.inspect}"
      when 1
        matches.first
      else
        raise Error, "slug #{input.inspect} is ambiguous: #{matches.sort.join(', ')}"
      end
    end

    def ensure_tracking_files(slug)
      archived = archive_dir(slug)
      raise Error, "archived slug cannot be reused: #{archived}" if File.exist?(archived)

      FileUtils.mkdir_p(work_dir(slug))
      FileUtils.mkdir_p(worktrees_dir(slug))
      write_once(plan_file(slug), plan_skeleton(slug))
      write_once(state_file(slug), state_skeleton(slug))
    end

    def current_slug
      sources = []

      env_slug = @env[ENV_SLUG]
      unless env_slug.nil? || env_slug.empty?
        validate_part!(env_slug, "#{ENV_SLUG} value")
        validate_workspace_identity!(@env[ENV_WORKSPACE], 'session environment')
        sources << [ENV_SLUG, env_slug]
      end

      tmux_session = if tmux_caller_context?
                       @tmux.current_session_identity(@env.fetch('TMUX_PANE'))
                     end
      if tmux_session
        validate_part!(tmux_session.name, 'tmux session slug')
        validate_workspace_identity!(tmux_session.workspace, 'current tmux session')
        sources << ['tmux', tmux_session.name]
      end

      cwd_slug = slug_from_path(@cwd)
      sources << ['cwd', cwd_slug] if cwd_slug

      slugs = sources.map(&:last).uniq
      case slugs.length
      when 0
        raise Error, 'no current dev session found'
      when 1
        slugs.first
      else
        details = sources.map { |source, slug| "#{source}=#{slug}" }.join(', ')
        raise Error, "current dev session sources disagree: #{details}"
      end
    end

    def tmux_caller_context?
      %w[TMUX TMUX_PANE].all? do |name|
        value = @env[name]
        !value.nil? && !value.empty?
      end
    end

    private

    def print_rows(rows)
      return if rows.empty?

      columns = [
        [:slug, 'SLUG', :left],
        [:work, 'WORK', :left],
        [:worktrees, 'WORKTREES', :right],
        [:tmux, 'TMUX', :left]
      ]

      widths = columns.to_h do |key, title, _align|
        [
          key,
          ([title.length] + rows.map { |row| row.fetch(key).length }).max
        ]
      end

      @out.puts format_row(
        columns.to_h { |key, title, _align| [key, title] },
        columns,
        widths,
        header: true
      )

      rows.each do |row|
        @out.puts format_row(row, columns, widths, header: false)
      end
    end

    def format_row(row, columns, widths, header:)
      columns.map do |key, _title, align|
        value = row.fetch(key)
        if !header && align == :right
          value.rjust(widths.fetch(key))
        else
          value.ljust(widths.fetch(key))
        end
      end.join('  ')
    end

    def worktree_dirty?(path)
      !git_capture(['git', '-C', path, 'status', '--porcelain']).empty?
    end

    def remove_empty_dir(path)
      FileUtils.rmdir(path)
    rescue Errno::ENOENT, Errno::ENOTEMPTY, Errno::EEXIST
      nil
    end

    def ensure_directory!(path, label, create:)
      if path_exists?(path)
        raise Error, "#{label} is a symlink: #{path}" if File.symlink?(path)
        raise Error, "#{label} is not a directory: #{path}" unless File.directory?(path)
      elsif create
        FileUtils.mkdir_p(path)
      else
        raise Error, "#{label} not found: #{path}"
      end

      path
    end

    def with_slug_lock(slug)
      root = File.join(workspace, 'worktrees')
      ensure_directory!(root, 'worktrees root', create: true)
      lock_root = File.join(root, '.locks')
      ensure_directory!(lock_root, 'dev-session lock directory', create: true)
      path = File.join(lock_root, "#{slug}.lock")
      raise Error, "dev-session lock is a symlink: #{path}" if File.symlink?(path)

      File.open(path, File::RDWR | File::CREAT, 0o600) do |file|
        unless file.flock(File::LOCK_EX | File::LOCK_NB)
          raise Error, "another dev-session command is changing #{slug}"
        end

        yield
      ensure
        file.flock(File::LOCK_UN)
      end
    end

    def path_exists?(path)
      File.lstat(path)
      true
    rescue Errno::ENOENT
      false
    end

    def create_tmux_session(slug, run_codex:)
      work_path = work_dir(slug)
      worktrees_path = worktrees_dir(slug)
      command = [
        'new-session',
        '-d',
        '-P',
        '-F',
        '#{session_id}',
        '-s',
        slug,
        '-n',
        'dev',
        '-c',
        workspace,
        *tmux_environment_args(slug)
      ]

      created_id = @tmux.capture(*command).first.strip
      session = @tmux.session_by_id(created_id)
      unless session && session.id == created_id && session.name == slug &&
             workspace_identity?(session.workspace)
        raise Error, "new tmux session changed during creation: #{slug}"
      end

      begin
        session_target = Tmux.session_target(session.id)
        dev_target = Tmux.window_target(session.id, 'dev')
        set_tmux_environment(session.id, slug)
        @tmux.run('set-window-option', '-t', dev_target, WINDOW_KIND, 'dev')

        left = @tmux.capture(
          'display-message',
          '-p',
          '-t',
          dev_target,
          '#{pane_id}'
        ).first.strip

        right = @tmux.capture(
          'split-window',
          '-h',
          *tmux_environment_args(slug),
          '-P',
          '-F',
          '#{pane_id}',
          '-t',
          dev_target,
          '-c',
          work_path
        ).first.strip

        @tmux.capture(
          'split-window',
          '-v',
          *tmux_environment_args(slug),
          '-P',
          '-F',
          '#{pane_id}',
          '-t',
          right,
          '-c',
          worktrees_path
        )

        @tmux.run('select-pane', '-t', left)

        if run_codex
          @tmux.run('send-keys', '-t', left, '-l', @codex_command)
          @tmux.run('send-keys', '-t', left, 'Enter')
        end

        @tmux.run('set-option', '-t', session_target, SESSION_SLUG, slug)
        @tmux.run('set-option', '-t', session_target, SESSION_MARK, '1')
        ensure_managed_session!(slug, session: @tmux.session_by_id(created_id))
      rescue StandardError
        cleanup_partial_tmux_session(created_id, slug)
        raise
      end
    end

    def cleanup_partial_tmux_session(id, slug)
      session = @tmux.session_by_id(id)
      return unless session && session.name == slug && workspace_identity?(session.workspace)
      return unless ['', slug].include?(session.slug) && ['', '1'].include?(session.mark)

      @tmux.run('kill-session', '-t', Tmux.session_target(id))
    rescue StandardError => e
      @err.puts "warning: unable to remove partial tmux session #{slug}: #{e.message}"
    end

    def sync_slug(slug, require_session:, session: nil)
      if session
        session = revalidate_session!(session)
      else
        session = @tmux.session(slug)
        unless session
          return unless require_session

          raise Error, "tmux session not found: #{slug}"
        end

        session = ensure_managed_session!(slug, session:)
      end
      set_tmux_environment(session.id, slug)
      session = ensure_managed_session!(slug, session: @tmux.session_by_id(session.id))

      desired = worktree_entries(slug)
      desired_paths = desired.map { |entry| entry.fetch(:path) }
      windows = @tmux.windows(session.id)
      managed_paths = windows
                      .select { |window| window.kind == 'worktree' }
                      .map(&:worktree)

      desired.each do |entry|
        next if managed_paths.include?(entry.fetch(:path))

        window_id = @tmux.capture(
          'new-window',
          '-d',
          '-P',
          '-F',
          '#{window_id}',
          '-t',
          Tmux.session_target(session.id),
          '-n',
          entry.fetch(:name),
          *tmux_environment_args(slug),
          '-c',
          entry.fetch(:path)
        ).first.strip

        @tmux.run('set-window-option', '-t', window_id, WINDOW_KIND, 'worktree')
        @tmux.run('set-window-option', '-t', window_id, WINDOW_WORKTREE, entry.fetch(:path))
      end

      windows.each do |window|
        next unless window.kind == 'worktree'
        next if desired_paths.include?(window.worktree)

        @tmux.run('kill-window', '-t', window.id)
      end

      revalidate_session!(session)
    end

    def ensure_managed_session!(slug, session: @tmux.session(slug))
      raise Error, "tmux session not found: #{slug}" unless session
      return session if managed_by_workspace?(session)

      raise Error, "tmux session is not managed by this workspace: #{slug}"
    end

    def managed_by_workspace?(session)
      session.managed? && workspace_identity?(session.workspace)
    end

    def workspace_identity?(candidate)
      candidate && File.realpath(candidate) == workspace
    rescue Errno::ENOENT, Errno::EACCES
      false
    end

    def validate_workspace_identity!(candidate, source)
      return if workspace_identity?(candidate)

      raise Error, "#{source} is not managed by this workspace"
    end

    def revalidate_session!(expected)
      current = @tmux.session_by_id(expected.id)
      return current if current == expected

      raise Error, "tmux session changed during operation: #{expected.name}"
    end

    def attach_to_session(session)
      revalidate_session!(session)
      if ENV['TMUX'] && !ENV['TMUX'].empty?
        @tmux.run('switch-client', '-t', Tmux.session_target(session.id))
      else
        exec(*attach_command(session.id))
      end
    end

    def attach_command(session)
      @tmux.argv('attach-session', '-t', Tmux.session_target(session))
    end

    def session_environment(slug)
      {
        ENV_SLUG => slug,
        ENV_WORKSPACE => workspace,
        ENV_WORK_DIR => work_dir(slug),
        ENV_WORKTREES_DIR => worktrees_dir(slug)
      }
    end

    def tmux_environment_args(slug)
      session_environment(slug).flat_map do |key, value|
        ['-e', "#{key}=#{value}"]
      end
    end

    def set_tmux_environment(target, slug)
      session_environment(slug).each do |key, value|
        @tmux.run('set-environment', '-t', Tmux.session_target(target), key, value)
      end
    end

    def worktree_entries(slug)
      root = worktrees_dir(slug)
      return [] unless File.directory?(root)

      Dir.children(root).sort.filter_map do |name|
        path = File.join(root, name)
        next unless File.directory?(path)
        next unless File.exist?(File.join(path, '.git'))

        { name:, path: File.expand_path(path) }
      end
    end

    def unexpected_worktree_entries(slug, entries)
      root = worktrees_dir(slug)
      return [] unless File.directory?(root)

      managed_names = entries.map { |entry| File.basename(entry.fetch(:path)) }
      Dir.children(root).sort - managed_names
    end

    def known_slugs
      sessions = @tmux.managed_session_identities
                      .select { |identity| managed_by_workspace?(identity) }
                      .select { |identity| valid_part?(identity.name) }
                      .map(&:name)
      (slug_dirs('work') + slug_dirs('worktrees') + sessions).uniq.sort
    end

    def slug_dirs(name)
      root = File.join(workspace, name)
      return [] unless File.directory?(root)

      Dir.children(root).select do |child|
        File.directory?(File.join(root, child)) && valid_part?(child)
      end
    end

    def repo_dir(project)
      File.join(workspace, 'repos', "#{project}.git")
    end

    def work_dir(slug)
      File.join(workspace, 'work', slug)
    end

    def archive_dir(slug)
      File.join(workspace, 'archive', slug)
    end

    def worktrees_dir(slug)
      File.join(workspace, 'worktrees', slug)
    end

    def plan_file(slug)
      File.join(work_dir(slug), 'plan.md')
    end

    def state_file(slug)
      File.join(work_dir(slug), 'state.md')
    end

    def slug_from_path(path)
      expanded = File.expand_path(path)

      [
        File.join(workspace, 'work'),
        File.join(workspace, 'worktrees')
      ].each do |root|
        slug = slug_from_path_under_root(root, expanded)
        return slug if slug
      end

      nil
    end

    def slug_from_path_under_root(root, path)
      expanded_root = File.expand_path(root)
      prefix = "#{expanded_root}#{File::SEPARATOR}"
      return nil unless path.start_with?(prefix)

      slug = path.delete_prefix(prefix).split(File::SEPARATOR, 2).first
      return nil if slug.nil? || slug.empty?
      return nil unless valid_part?(slug)

      slug
    end

    def write_once(path, content)
      return if File.exist?(path)

      File.write(path, content)
    end

    def plan_skeleton(slug)
      <<~PLAN
        # #{slug}

        ## Goal

        ## Affected repositories

        ## Approach

        ## Compatibility and deployment

        ## Testing plan
      PLAN
    end

    def state_skeleton(slug)
      <<~STATE
        # #{slug}

        ## Repositories

        ## Status

        - Lifecycle: active

        ## Commands run

        ## Results

        ## Open questions

        ## Cleanup
      STATE
    end

    def validate_tracking_files!(slug)
      missing = [plan_file(slug), state_file(slug)].reject { |path| File.file?(path) }
      return if missing.empty?

      raise Error, "missing tracking files: #{missing.join(', ')}"
    end

    def validate_terminal_lifecycle!(slug)
      matches = File.readlines(state_file(slug), chomp: true).filter_map do |line|
        match = line.match(/\A- Lifecycle: (active|complete|abandoned)\z/)
        match && match[1]
      end

      unless matches.length == 1
        raise Error, 'state.md must contain exactly one lifecycle marker'
      end

      return if %w[complete abandoned].include?(matches.first)

      raise Error, "initiative lifecycle is not terminal: #{matches.first}"
    end

    def validate_tracking_committed!(slug)
      missing = %w[plan.md state.md].reject do |name|
        path = File.join('work', slug, name)
        _stdout, _stderr, status = @command_runner.capture(
          ['git', '-C', workspace, 'cat-file', '-e', "HEAD:#{path}"],
          allow_failure: true
        )
        status.success?
      end
      return if missing.empty?

      raise Error, "tracking files have no prior commit: #{missing.join(', ')}"
    end

    def origin_head(repo)
      stdout, _stderr, status = @command_runner.capture(
        [
          'git',
          "--git-dir=#{repo}",
          'symbolic-ref',
          '--quiet',
          '--short',
          'refs/remotes/origin/HEAD'
        ],
        allow_failure: true
      )
      return stdout.strip if status.success? && !stdout.strip.empty?

      'origin/master'
    end

    def branch_exists?(repo, branch)
      _stdout, _stderr, status = @command_runner.capture(
        ['git', "--git-dir=#{repo}", 'show-ref', '--verify', '--quiet', "refs/heads/#{branch}"],
        allow_failure: true
      )
      status.success?
    end

    def validate_git_branch!(branch)
      stdout, _stderr, status = @command_runner.capture(
        ['git', 'check-ref-format', '--branch', branch],
        allow_failure: true
      )
      return if status.success? && stdout.strip == branch

      raise Error, "invalid branch name: #{branch.inspect}"
    end

    def git_capture(argv)
      stdout, _stderr, _status = @command_runner.capture(argv)
      stdout
    end

    def validate_part!(value, label)
      return if valid_part?(value)

      raise Error, "invalid #{label}: #{value.inspect}"
    end

    def valid_part?(value)
      value.is_a?(String) && value.match?(SAFE_PART)
    end

    def dated_slug?(value)
      value.match?(/\A\d{4}-\d{2}-\d{2}-/)
    end
  end

  class CLI
    def initialize(argv, out: $stdout, err: $stderr)
      @argv = argv.dup
      @out = out
      @err = err
      @workspace = File.expand_path('..', __dir__)
      @tmux_socket = nil
    end

    def run
      parse_global_options
      command = @argv.shift
      raise Error, USAGE unless command

      case command
      when 'start'
        run_start
      when 'attach'
        run_single_slug { |runner, slug, opts| runner.attach(slug, as_is: opts[:as_is]) }
      when 'sync'
        run_single_slug { |runner, slug, opts| runner.sync(slug, as_is: opts[:as_is]) }
      when 'stop'
        run_single_slug { |runner, slug, opts| runner.stop(slug, as_is: opts[:as_is]) }
      when 'remove'
        run_remove
      when 'finalize'
        run_single_slug do |runner, slug, opts|
          runner.finalize(slug, as_is: opts[:as_is])
        end
      when 'list'
        run_list
      when 'current'
        run_current
      when 'worktree'
        run_worktree
      else
        raise Error, "unknown command: #{command}"
      end

      0
    rescue OptionParser::ParseError, Error => e
      @err.puts "error: #{e.message}"
      1
    end

    private

    def parse_global_options
      until @argv.empty?
        case @argv.first
        when '--workspace'
          @argv.shift
          @workspace = File.expand_path(@argv.shift || raise(Error, '--workspace requires DIR'))
        when /\A--workspace=(.+)\z/
          @workspace = File.expand_path(Regexp.last_match(1))
          @argv.shift
        when '--tmux-socket'
          @argv.shift
          @tmux_socket = @argv.shift || raise(Error, '--tmux-socket requires NAME')
        when /\A--tmux-socket=(.+)\z/
          @tmux_socket = Regexp.last_match(1)
          @argv.shift
        when '-h', '--help'
          @out.puts USAGE
          exit 0
        else
          break
        end
      end
    end

    def runner
      @runner ||= Runner.new(workspace: @workspace, tmux_socket: @tmux_socket, out: @out, err: @err)
    end

    def run_start
      opts = { as_is: false, new: false, attach: nil, run_codex: true }
      parser = OptionParser.new do |parser_opts|
        parser_opts.on('--as-is') { opts[:as_is] = true }
        parser_opts.on('--new') { opts[:new] = true }
        parser_opts.on('--attach') { opts[:attach] = true }
        parser_opts.on('--no-attach') { opts[:attach] = false }
        parser_opts.on('--no-codex') { opts[:run_codex] = false }
      end
      parser.parse!(@argv)
      require_arity!(1, @argv, 'start')

      runner.start(@argv.fetch(0), **opts)
    end

    def run_single_slug
      opts = { as_is: false }
      parser = OptionParser.new do |parser_opts|
        parser_opts.on('--as-is') { opts[:as_is] = true }
      end
      parser.parse!(@argv)
      require_arity!(1, @argv, 'command')

      yield runner, @argv.fetch(0), opts
    end

    def run_list
      opts = { as_is: false }
      parser = OptionParser.new do |parser_opts|
        parser_opts.on('--as-is') { opts[:as_is] = true }
      end
      parser.parse!(@argv)
      require_arity!(0..1, @argv, 'list')

      runner.list(@argv.first, as_is: opts[:as_is])
    end

    def run_current
      require_arity!(0, @argv, 'current')

      runner.current
    end

    def run_remove
      opts = { as_is: false, force: false }
      parser = OptionParser.new do |parser_opts|
        parser_opts.on('--as-is') { opts[:as_is] = true }
        parser_opts.on('--force') { opts[:force] = true }
      end
      parser.parse!(@argv)
      require_arity!(1, @argv, 'remove')

      runner.remove(@argv.fetch(0), **opts)
    end

    def run_worktree
      subcommand = @argv.shift
      raise Error, 'missing worktree subcommand' unless subcommand

      case subcommand
      when 'add'
        run_worktree_add
      when 'remove'
        run_worktree_remove
      else
        raise Error, "unknown worktree subcommand: #{subcommand}"
      end
    end

    def run_worktree_add
      opts = {
        as_is: false,
        name: nil,
        branch: nil,
        base: nil,
        fetch: true
      }

      parser = OptionParser.new do |parser_opts|
        parser_opts.on('--as-is') { opts[:as_is] = true }
        parser_opts.on('--name NAME') { |v| opts[:name] = v }
        parser_opts.on('--branch BRANCH') { |v| opts[:branch] = v }
        parser_opts.on('--base REF') { |v| opts[:base] = v }
        parser_opts.on('--no-fetch') { opts[:fetch] = false }
      end
      parser.parse!(@argv)
      require_arity!(2, @argv, 'worktree add')

      runner.worktree_add(@argv.fetch(0), @argv.fetch(1), **opts)
    end

    def run_worktree_remove
      opts = { as_is: false, force: false }

      parser = OptionParser.new do |parser_opts|
        parser_opts.on('--as-is') { opts[:as_is] = true }
        parser_opts.on('--force') { opts[:force] = true }
      end
      parser.parse!(@argv)
      require_arity!(2, @argv, 'worktree remove')

      runner.worktree_remove(@argv.fetch(0), @argv.fetch(1), **opts)
    end

    def require_arity!(expected, args, command)
      ok = if expected.is_a?(Range)
             expected.cover?(args.length)
           else
             args.length == expected
           end
      return if ok

      raise Error, "wrong number of arguments for #{command}"
    end
  end
end

if $PROGRAM_NAME == __FILE__
  exit VpsfreeDevSession::CLI.new(ARGV).run
end
